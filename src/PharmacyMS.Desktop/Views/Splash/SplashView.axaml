<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Splash.SplashView"
        Background="White">
  <Grid>

    <!-- Red title bar strip behind the native traffic-light buttons -->
    <Rectangle Height="34" VerticalAlignment="Top" HorizontalAlignment="Stretch"
               Fill="#E11D2A" ZIndex="100"/>

    <!-- Background photo -->
    <Image Source="avares://PharmacyMS.Desktop/Assets/splash-bg.jpg"
           Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
           Opacity="0.48"/>

    <!-- White scrim on top of the photo so it reads light, not tinted -->
    <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Fill="#FFFFFF" Opacity="0.74"/>

    <Panel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="260" ClipToBounds="True">
      <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Canvas Width="1400" Height="400">
          <Path Fill="#E11D2A">
            <Path.Data>
              <PathGeometry>
                M 0,80 C 400,180 800,-20 1400,60 L 1400,400 L 0,400 Z
              </PathGeometry>
            </Path.Data>
          </Path>
        </Canvas>
      </Viewbox>
    </Panel>

    <Panel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="260" ClipToBounds="True">
      <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Canvas Width="1400" Height="400">
          <Path Stroke="White" StrokeThickness="3" Fill="Transparent">
            <Path.Data>
              <PathGeometry>
                M -50,110 C 350,210 750,10 1450,90
              </PathGeometry>
            </Path.Data>
          </Path>
        </Canvas>
      </Viewbox>
    </Panel>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Margin="0,-60,0,0">

      <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
             Width="150" Height="150"
             HorizontalAlignment="Center" Margin="0,0,0,16"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="Pharma" FontSize="48" FontWeight="Bold" Foreground="#E11D2A"/>
        <TextBlock Text="Pro" FontSize="48" FontWeight="Bold" Foreground="#1A1A1A"/>
      </StackPanel>
      <TextBlock Text="Pharmacy Management System" FontSize="16" FontWeight="Medium" Foreground="#333333" HorizontalAlignment="Center"/>
      <TextBlock Text="Smart Pharmacy. Stronger Business." FontSize="14" FontWeight="SemiBold" Foreground="#E11D2A" HorizontalAlignment="Center" Margin="0,8,0,0"/>

      <StackPanel Width="360" Margin="0,32,0,0" Spacing="8">
        <TextBlock x:Name="LoadingText" Text="Loading..." FontSize="12" Foreground="#333333" HorizontalAlignment="Center"/>
        <ProgressBar x:Name="SplashProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" CornerRadius="4"
                     Background="#E5E5E5" Foreground="#E11D2A"/>
        <TextBlock x:Name="PercentText" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Width="180" Spacing="6" HorizontalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="22" Background="White" HorizontalAlignment="Center">
          <Viewbox Width="22" Height="22">
            <Path Data="M4.5 12.5l7.086 -7.086a4 4 0 1 1 5.657 5.657l-7.086 7.086a4 4 0 1 1 -5.657 -5.657z M8.5 8.5l7 7"
                  Stroke="#E11D2A" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
          </Viewbox>
        </Border>
        <TextBlock Text="Medicine" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Management" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Width="180" Spacing="6" HorizontalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="22" Background="White" HorizontalAlignment="Center">
          <Viewbox Width="22" Height="22">
            <Path Data="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"
                  Stroke="#E11D2A" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
          </Viewbox>
        </Border>
        <TextBlock Text="Sale &amp;" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="POS" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Width="180" Spacing="6" HorizontalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="22" Background="White" HorizontalAlignment="Center">
          <Viewbox Width="22" Height="22">
            <Path Data="M16.5 9.4 7.55 4.24 M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z M3.3 7 12 12l8.7-5 M12 22V12"
                  Stroke="#E11D2A" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
          </Viewbox>
        </Border>
        <TextBlock Text="Inventory &amp;" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Stock" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="3" Width="180" Spacing="6" HorizontalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="22" Background="White" HorizontalAlignment="Center">
          <Viewbox Width="22" Height="22">
            <Path Data="M3 3v16a2 2 0 0 0 2 2h16 M18 17V9 M13 17V5 M8 17v-3"
                  Stroke="#E11D2A" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
          </Viewbox>
        </Border>
        <TextBlock Text="Reports &amp;" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Analytics" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="www.pharmapro.com" FontSize="12" Foreground="White"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
  </Grid>
</UserControl>
