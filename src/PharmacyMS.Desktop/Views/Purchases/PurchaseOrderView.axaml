<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:ent="clr-namespace:PharmacyMS.Domain.Entities;assembly=PharmacyMS.Domain"
             x:Class="PharmacyMS.Desktop.Views.Purchases.PurchaseOrderView"
             x:DataType="vm:PurchaseOrderViewModel">

  <Grid ColumnDefinitions="*,420" Margin="24">

    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Medicines" FontSize="18" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,14"/>
        <DataGrid x:Name="MedicineGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:Medicine"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  Foreground="#0F172A"
                  RowBackground="White">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
            <DataGridTextColumn Header="Stock" Binding="{Binding QuantityInStock}" Width="80"/>
            <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPrice}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
      <DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="New Purchase Order" FontSize="18" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,14"/>

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
          <ComboBox x:Name="SupplierCombo" HorizontalAlignment="Stretch" PlaceholderText="Select supplier"
                    Height="34">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="ent:Supplier">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <DatePicker x:Name="ExpectedDatePicker" HorizontalAlignment="Stretch"/>
          <TextBox x:Name="NotesBox" PlaceholderText="Notes (optional)" Height="34"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="QtyBox" Width="70" Text="1" Height="34" PlaceholderText="Qty"/>
            <ComboBox x:Name="UnitBox" Width="100" Height="34" SelectedIndex="0"/>
            <TextBox x:Name="CostBox" Width="90" Height="34" PlaceholderText="Cost"/>
          </StackPanel>

          <Button x:Name="AddLineButton" Content="Add Line" Height="36"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="#F1F5F9" Foreground="#0F172A" CornerRadius="6"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Spacing="10">
          <TextBlock x:Name="StatusText" IsVisible="False" FontSize="13" Foreground="#1D9E75"/>
          <TextBlock x:Name="TotalText" Text="Total: $0.00" FontSize="18" FontWeight="Bold"
                     Foreground="#0F172A"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="SaveDraftButton" Grid.Column="0" Content="Save Draft" Height="44"
                    Background="#F1F5F9" Foreground="#0F172A" CornerRadius="8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send to Supplier" Height="44"
                    Background="#1D9E75" Foreground="White" CornerRadius="8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>
        </StackPanel>

        <DataGrid x:Name="LinesGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="vm:PurchaseOrderLine"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  Foreground="#0F172A"
                  RowBackground="White">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Medicine" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
            <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost}" Width="70"/>
            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal}" Width="80"/>
            <DataGridTemplateColumn Header="" Width="40">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:PurchaseOrderLine">
                  <Button Content="&#10005;" Tag="{Binding}" Click="RemoveLineButton_Click"
                          Padding="4,2" Background="Transparent" BorderThickness="0"
                          Foreground="#DC2626" FontSize="13" FontWeight="Bold"
                          ToolTip.Tip="Remove line"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

      </DockPanel>
    </Border>

  </Grid>
</UserControl>
