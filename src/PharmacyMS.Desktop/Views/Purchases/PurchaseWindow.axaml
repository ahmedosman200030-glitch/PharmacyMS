<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
        xmlns:ent="clr-namespace:PharmacyMS.Domain.Entities;assembly=PharmacyMS.Domain"
        x:Class="PharmacyMS.Desktop.Views.Purchases.PurchaseWindow"
        x:DataType="vm:PurchaseViewModel"
        Title="New Purchase"
        Width="1150" Height="700"
        Background="#F1F5F9">

  <Grid ColumnDefinitions="*,420" Margin="20">

    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Medicines" FontSize="18" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,14"/>
        <DataGrid VerticalScrollBarVisibility="Auto" x:Name="MedicineGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:Medicine"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  Foreground="#0F172A"
                  RowBackground="White">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
            <DataGridTextColumn Header="Stock" Binding="{Binding QuantityInStock}" Width="80"/>
            <DataGridTextColumn Header="Current Batch" Binding="{Binding BatchNumber}" Width="140"/>
            <DataGridTextColumn Header="Current Expiry" Binding="{Binding ExpiryDate}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="10,0,0,0">
      <DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Purchase Order" FontSize="18" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,14"/>

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
          <ComboBox x:Name="SupplierCombo" HorizontalAlignment="Stretch" PlaceholderText="Select supplier"
                    Height="34">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="ent:Supplier">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox x:Name="InvoiceBox" PlaceholderText="Invoice number (optional)" Height="34"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="QtyBox" Width="60" Text="1" Height="34" PlaceholderText="Qty"/>
            <TextBox x:Name="CostBox" Width="90" Height="34" PlaceholderText="Cost"/>
            <TextBox x:Name="BatchBox" Width="120" Height="34" PlaceholderText="Batch #"/>
          </StackPanel>
          <DatePicker x:Name="ExpiryPicker" HorizontalAlignment="Stretch"/>

          <Button x:Name="AddLineButton" Content="Add Line" Height="36"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="#F1F5F9" Foreground="#0F172A" CornerRadius="6"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Spacing="10">
          <TextBlock x:Name="TotalText" Text="Total: $0.00" FontSize="18" FontWeight="Bold"
                     Foreground="#0F172A"/>
          <Button x:Name="SubmitButton" Content="Confirm &amp; Receive" Height="44"
                  Background="#1D9E75" Foreground="White" CornerRadius="8"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <DataGrid VerticalScrollBarVisibility="Auto" x:Name="LinesGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="vm:PurchaseLine"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  Foreground="#0F172A"
                  RowBackground="White">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Medicine" Binding="{Binding Name}" Width="120"/>
            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="45"/>
            <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost}" Width="60"/>
            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="80"/>
            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>

      </DockPanel>
    </Border>

  </Grid>
</Window>
