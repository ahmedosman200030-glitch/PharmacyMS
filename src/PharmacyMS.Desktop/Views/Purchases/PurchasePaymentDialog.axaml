<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Purchases.PurchasePaymentDialog"
        Title="Record Payment"
        Width="360" Height="240"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        CanResize="False">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="SupplierText" FontSize="16" FontWeight="Bold" Foreground="White"/>
    <TextBlock x:Name="DueText" FontSize="13" Foreground="#94A3B8"/>
    <TextBlock Text="Payment Amount" FontSize="13" Foreground="#94A3B8" Margin="0,10,0,0"/>
    <TextBox x:Name="AmountBox" Height="34"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Height="34" Padding="14,0"
              Background="#334155" Foreground="White" CornerRadius="6"/>
      <Button x:Name="ConfirmButton" Content="Record Payment" Height="34" Padding="14,0"
              Background="#1D9E75" Foreground="White" CornerRadius="6"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12" IsVisible="False"/>
  </StackPanel>
</Window>
