<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PharmacyMS.Desktop.ViewModels"
    x:Class="PharmacyMS.Desktop.Views.Dashboard.DashboardView">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="RedGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FB7185" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RoseGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F87171" Offset="0"/>
            <GradientStop Color="#B91C1C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#60A5FA" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#C084FC" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#4ADE80" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AmberGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FCD34D" Offset="0"/>
            <GradientStop Color="#D97706" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="RoseTint" Color="#FFF1F2"/>
        <SolidColorBrush x:Key="GreenTint" Color="#F0FDF4"/>
        <SolidColorBrush x:Key="BlueTint" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="PurpleTint" Color="#FAF5FF"/>
        <SolidColorBrush x:Key="AmberTint" Color="#FFFBEB"/>
        <LinearGradientBrush x:Key="BlueHeaderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenHeaderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#22C55E" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleHeaderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#A855F7" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AmberSoftGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FEF3C7" Offset="0"/>
            <GradientStop Color="#FDE68A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RoseHeaderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#E11D48" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFCFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PageGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#F1F5F9" Offset="0"/>
            <GradientStop Color="#E8EDF5" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8EDF5"/>
            <Setter Property="BoxShadow" Value="0 2 4 0 #0A1E293B, 0 12 32 -8 #181E293B, 0 24 48 -20 #101E293B"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BoxShadow" Value="0 4 8 0 #0F1E293B, 0 20 40 -10 #221E293B, 0 32 64 -24 #181E293B"/>
            <Setter Property="RenderTransform" Value="translateY(-3px)"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="TextBlock.panel-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style Selector="TextBlock.view-all">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>
        <Style Selector="TextBlock.header-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.header-view-all">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="TextBlock.soft-header-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#92400E"/>
        </Style>
        <Style Selector="TextBlock.soft-header-viewall">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#D97706"/>
        </Style>
        <Style Selector="ListBox.plain">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem.plain">
            <Setter Property="Padding" Value="3,3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem.plain:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem.plain:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource PageGradient}">
        <Grid Margin="14,12,14,14" RowDefinitions="Auto,Auto,1.15*,*,Auto">

            <!-- Title + date -->
            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="WelcomeText" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="12,8"
                        VerticalAlignment="Center" BorderThickness="1" BorderBrush="#E8EDF5"
                        BoxShadow="0 2 8 0 #0A1E293B">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#128197;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TodayDateText" FontSize="12" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stat cards row -->
            <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="*,*,*,*">

                <!-- Total Sales -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Background="{StaticResource RoseTint}" ClipToBounds="True">
                    <Panel>
                        <!-- decorative circle -->
                        <Ellipse Width="90" Height="90" Fill="#FFE4E6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-20"/>
                        <StackPanel Spacing="6" ZIndex="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource RoseGradient}"
                                        BoxShadow="0 8 20 -4 #88E11D48" VerticalAlignment="Top">
                                    <Viewbox Width="24" Height="24">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                                  Data="M6,2 L3,6 L3,20 C3,21.1 3.9,22 5,22 L19,22 C20.1,22 21,21.1 21,20 L21,6 L18,2 Z M3,6 L21,6 M16,10 C16,12.2 14.2,14 12,14 C9.8,14 8,12.2 8,10"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="stat-label" Text="Total Sales"/>
                                    <TextBlock x:Name="RevenueText" Classes="stat-value"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock x:Name="RevenueTrendText" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="vs yesterday" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <Canvas x:Name="RevenueSparkCanvas" Height="22"/>
                        </StackPanel>
                    </Panel>
                </Border>

                <!-- Total Profit -->
                <Border Grid.Column="1" Classes="card" Margin="0,0,10,0" Background="{StaticResource GreenTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="90" Height="90" Fill="#DCFCE7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-20"/>
                        <StackPanel Spacing="6" ZIndex="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource GreenGradient}"
                                        BoxShadow="0 8 20 -4 #6616A34A" VerticalAlignment="Top">
                                    <Viewbox Width="24" Height="24">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                                  Data="M12,2 C8.7,2 6,4.7 6,8 C6,11.3 8.7,14 12,14 C15.3,14 18,11.3 18,8 C18,4.7 15.3,2 12,2 Z M12,6 L12,10 M10,8 L14,8"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="stat-label" Text="Total Profit"/>
                                    <TextBlock x:Name="ProfitText" Classes="stat-value"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock x:Name="ProfitTrendText" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="vs yesterday" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <Canvas x:Name="ProfitSparkCanvas" Height="22"/>
                        </StackPanel>
                    </Panel>
                </Border>

                <!-- Total Transactions -->
                <Border Grid.Column="2" Classes="card" Margin="0,0,10,0" Background="{StaticResource BlueTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="90" Height="90" Fill="#DBEAFE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-20"/>
                        <StackPanel Spacing="6" ZIndex="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource BlueGradient}"
                                        BoxShadow="0 8 20 -4 #663B82F6" VerticalAlignment="Top">
                                    <Viewbox Width="24" Height="24">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                                  Data="M6,2 L18,2 C19.1,2 20,2.9 20,4 L20,20 C20,21.1 19.1,22 18,22 L6,22 C4.9,22 4,21.1 4,20 L4,4 C4,2.9 4.9,2 6,2 Z M8,7 L16,7 M8,11 L16,11 M8,15 L13,15"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="stat-label" Text="Total Transactions"/>
                                    <TextBlock x:Name="TransactionsText" Classes="stat-value"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock x:Name="TransactionsTrendText" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="vs yesterday" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <Canvas x:Name="TransactionsSparkCanvas" Height="22"/>
                        </StackPanel>
                    </Panel>
                </Border>

                <!-- New Customers -->
                <Border Grid.Column="3" Classes="card" Background="{StaticResource PurpleTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="90" Height="90" Fill="#EDE9FE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-20"/>
                        <StackPanel Spacing="6" ZIndex="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource PurpleGradient}"
                                        BoxShadow="0 8 20 -4 #66A855F7" VerticalAlignment="Top">
                                    <Viewbox Width="24" Height="24">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                                  Data="M17,21 L17,19 C17,16.8 15.2,15 13,15 L5,15 C2.8,15 1,16.8 1,19 L1,21 M9,11 C11.2,11 13,9.2 13,7 C13,4.8 11.2,3 9,3 C6.8,3 5,4.8 5,7 C5,9.2 6.8,11 9,11 Z M23,21 L23,19 C23,17.1 21.7,15.5 20,15.1 M16,3.1 C17.7,3.5 19,5.1 19,7 C19,8.9 17.7,10.5 16,10.9"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="stat-label" Text="New Customers"/>
                                    <TextBlock x:Name="NewCustomersText" Classes="stat-value"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock x:Name="NewCustomersTrendText" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="vs yesterday" FontSize="11" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <Canvas x:Name="NewCustomersSparkCanvas" Height="22"/>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>

            <!-- Sales overview + low stock alert -->
            <Grid Grid.Row="2" Margin="0,0,0,10" ColumnDefinitions="2*,1*">
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{StaticResource RoseHeaderGradient}" CornerRadius="20,20,0,0" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="&#128200;" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Classes="header-title" Text="Sales Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="ChartRangeCombo" Width="140" SelectedIndex="0" CornerRadius="10">
                                    <ComboBoxItem Content="Last 7 Days"/>
                                    <ComboBoxItem Content="Last 4 Weeks"/>
                                    <ComboBoxItem Content="Last 6 Months"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="40,*" Margin="12">
                            <Canvas Grid.Column="0" x:Name="YAxisCanvas"/>
                            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                                <Canvas Grid.Row="0" x:Name="SalesChartCanvas" ClipToBounds="False" Background="Transparent"/>
                                <Canvas Grid.Row="1" x:Name="XAxisCanvas" Height="18" Margin="0,4,0,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{StaticResource AmberSoftGradient}" CornerRadius="20,20,0,0" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="&#9888;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#D97706"/>
                                <TextBlock Grid.Column="1" Classes="soft-header-title" Text="Low Stock Alert" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="ViewAllLowStockText" Classes="soft-header-viewall" Text="View all" Cursor="Hand" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="LowStockList" Classes="plain" Margin="10,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LowStockRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                                Background="{Binding FallbackColor}" Margin="0,0,10,0"
                                                ClipToBounds="True" BoxShadow="0 4 8 -2 #281E293B">
                                            <Panel>
                                                <TextBlock Text="&#128138;" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasImage}"/>
                                                <Image Source="{Binding MedicineImage}"
                                                       Stretch="Uniform" Width="34" Height="34"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasImage}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#111827" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RemainingText}" FontSize="10"
                                                       Foreground="#9CA3AF"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4"
                                                Background="{Binding StatusBgColor}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding StatusTextColor}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Payment methods + top medicines + recent transactions -->
            <Grid Grid.Row="3" Margin="0,0,0,10" ColumnDefinitions="*,*,*">
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Background="{StaticResource BlueHeaderGradient}" CornerRadius="20,20,0,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#128200;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Classes="header-title" Text="Sales by Payment Method"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="10,8,10,4">
                            <Canvas Grid.Column="0" x:Name="PaymentDonutCanvas" Width="200" Height="200">
                                <TextBlock x:Name="PaymentTotalText" FontSize="18" FontWeight="Bold" Foreground="#111827"
                                           Canvas.Left="60" Canvas.Top="85" Width="80" TextAlignment="Center"/>
                                <TextBlock Text="Total" FontSize="10" Foreground="#9CA3AF"
                                           Canvas.Left="60" Canvas.Top="107" Width="80" TextAlignment="Center"/>
                            </Canvas>
                            <ItemsControl Grid.Column="1" x:Name="PaymentLegendList" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PaymentMethodSlice">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="0,5">
                                            <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="11" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <!-- Most used footer -->
                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,20,20" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#128717;" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MostUsedPaymentText" FontSize="11" Foreground="#374151" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Margin="0,0,10,0" Padding="0" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{StaticResource GreenHeaderGradient}" CornerRadius="20,20,0,0" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#128138;" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Classes="header-title" Text="Top Selling Medicines"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="ViewAllTopMedicinesText" Classes="header-view-all" Text="View all" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="TopMedicinesList" Classes="plain" Margin="10,8" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopMedicineRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11"
                                                Background="{Binding FallbackColor}" Margin="0,0,10,0"
                                                ClipToBounds="True" BoxShadow="0 3 8 -2 #281E293B">
                                            <Panel>
                                                <TextBlock Text="{Binding FallbackEmoji}" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasImage}"/>
                                                <Image Source="{Binding MedicineImage}"
                                                       Stretch="Uniform" Width="30" Height="30"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasImage}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#111827" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="10"
                                                Padding="8,4" VerticalAlignment="Center" MinWidth="44">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding QuantitySold}" FontSize="12" FontWeight="Bold"
                                                           Foreground="#EF4444" HorizontalAlignment="Center"/>
                                                <TextBlock Text="QTY" FontSize="8" Foreground="#EF4444"
                                                           HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{StaticResource PurpleHeaderGradient}" CornerRadius="20,20,0,0" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="&#128196;" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Classes="header-title" Text="Recent Transactions"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="ViewAllRecentTransactionsText" Classes="header-view-all" Text="View all" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="RecentTransactionsList" Classes="plain" Margin="10,8" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentTransactionRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11"
                                                Background="#FEE2E2" Margin="0,0,10,0"
                                                BoxShadow="0 3 8 -2 #28E11D48">
                                            <TextBlock Text="&#128196;" FontSize="15" Foreground="#B91C1C"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding InvoiceNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock Text="{Binding CustomerName}" FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding AmountText}" FontSize="13" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10" FontWeight="SemiBold" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom strip -->
            <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Background="{StaticResource BlueTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="70" Height="70" Fill="#BFDBFE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-15"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" ZIndex="1">
                            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource BlueGradient}"
                                    BoxShadow="0 6 16 -4 #662563EB">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                              Data="M3,7 C3,5.9 3.9,5 5,5 L18,5 C19.1,5 20,5.9 20,7 L20,17 C20,18.1 19.1,19 18,19 L5,19 C3.9,19 3,18.1 3,17 Z M15,12 C15,10.9 15.9,10 17,10 L21,10 L21,14 L17,14 C15.9,14 15,13.1 15,12 Z"/>
                                        <Path Fill="White" Data="M17.5,12 C17.5,11.7 17.7,11.5 18,11.5 C18.3,11.5 18.5,11.7 18.5,12 C18.5,12.3 18.3,12.5 18,12.5 C17.7,12.5 17.5,12.3 17.5,12 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="stat-label" Text="Opening Balance"/>
                                <TextBlock x:Name="OpeningBalanceText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </Border>

                <Border Grid.Column="1" Classes="card" Margin="0,0,10,0" Background="{StaticResource AmberTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="70" Height="70" Fill="#FDE68A" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-15"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" ZIndex="1">
                            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource AmberGradient}"
                                    BoxShadow="0 6 16 -4 #66D97706">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                              Data="M12,3 L12,15 M6,9 L12,15 L18,9 M4,19 L20,19"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="stat-label" Text="Today's Expenses"/>
                                <TextBlock x:Name="TodayExpensesText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </Border>

                <Border Grid.Column="2" Classes="card" Margin="0,0,10,0" Background="{StaticResource GreenTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="70" Height="70" Fill="#BBF7D0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-15"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" ZIndex="1">
                            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource GreenGradient}"
                                    BoxShadow="0 6 16 -4 #6616A34A">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                              Data="M21,16 L12,21 L3,16 L3,8 L12,3 L21,8 Z M3,8 L12,13 L21,8 M12,21 L12,13"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="stat-label" Text="Stock Items"/>
                                <TextBlock x:Name="StockItemsText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </Border>

                <Border Grid.Column="3" Classes="card" Background="{StaticResource RoseTint}" ClipToBounds="True">
                    <Panel>
                        <Ellipse Width="70" Height="70" Fill="#FECDD3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-15,-15"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" ZIndex="1">
                            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource RoseGradient}"
                                    BoxShadow="0 6 16 -4 #66B91C1C">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                              Data="M12,9 L12,13 M12,17 L12.01,17 M10.29,3.86 L1.82,18 C1.64,18.32 1.55,18.68 1.56,19.05 C1.57,19.42 1.68,19.77 1.87,20.08 C2.07,20.39 2.35,20.65 2.68,20.82 C3.01,20.99 3.38,21.08 3.75,21.08 L20.25,21.08 C20.62,21.08 20.99,20.99 21.32,20.82 C21.65,20.65 21.93,20.39 22.13,20.08 C22.32,19.77 22.43,19.42 22.44,19.05 C22.45,18.68 22.36,18.32 22.18,18 L13.71,3.86 C13.53,3.56 13.27,3.31 12.96,3.14 C12.65,2.96 12.31,2.87 11.96,2.87 C11.6,2.87 11.26,2.96 10.96,3.14 C10.65,3.31 10.39,3.56 10.29,3.86 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="stat-label" Text="Expired Items"/>
                                <TextBlock x:Name="ExpiredItemsText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>

        </Grid>
    </Grid>

</UserControl>
