<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PharmacyMS.Desktop.ViewModels"
        x:Class="PharmacyMS.Desktop.Views.Shell.MainWindow"
        Title="PharmaPro — Smart Pharmacy Management"
        Width="1280" Height="800"
        FontFamily="Segoe UI, Inter, sans-serif"
        Background="{DynamicResource BrandBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.notifRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.notifRow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1F5F9"/>
    </Style>

    <Style Selector="Button.navBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.navBtn:pointerover">
      <Setter Property="Background" Value="#1B9C8540"/>
      <Setter Property="Foreground" Value="#6EE7B7"/>
    </Style>
    <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B9C8540"/>
    </Style>
    <Style Selector="Button.navBtn:pressed">
      <Setter Property="Background" Value="#1B9C8570"/>
    </Style>
    <Style Selector="Button.navBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B9C8570"/>
    </Style>
    <Style Selector="Button.navBtn.active">
      <Setter Property="Background" Value="#DC2626"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.navBtn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#DC2626"/>
    </Style>
  </Window.Styles>

  <Panel>
  <Grid ColumnDefinitions="240,*">

    <!-- SIDEBAR -->
    <Border Grid.Column="0" Background="#0F172A">
      <Border.Resources>
        <SolidColorBrush x:Key="ButtonBackground">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1B9C8540"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1B9C8570"/>
        <SolidColorBrush x:Key="ButtonForeground">White</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#6EE7B7"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#6EE7B7"/>
        <SolidColorBrush x:Key="ButtonBorderBrush">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed">Transparent</SolidColorBrush>
      </Border.Resources>
      <DockPanel>

        <!-- Brand row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,16,16,16">
          <Border x:Name="DefaultLogoBorder" Width="38" Height="38" CornerRadius="8" Background="White" Padding="3">
            <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
                   Stretch="Uniform"/>
          </Border>
          <Border Width="38" Height="38" CornerRadius="8" Background="White" Padding="3">
            <Image x:Name="LogoImage" Stretch="Uniform" IsVisible="False"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="0">
              <TextBlock x:Name="AppNameText" Text="PharmaPro" FontSize="15" FontWeight="Bold"
                         Foreground="White" TextWrapping="Wrap" MaxWidth="140"/>
            </StackPanel>
            <TextBlock Text="Smart Pharmacy" FontSize="9" Foreground="#64748B"/>
          </StackPanel>
        </StackPanel>

        <!-- Avatar + identity -->
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,20">
          <Button x:Name="AvatarButton" Width="84" Height="84" Padding="0" CornerRadius="42"
                  Background="#1E293B" HorizontalAlignment="Center" Cursor="Hand">
            <Border CornerRadius="42" ClipToBounds="True" Width="84" Height="84">
              <Grid>
                <TextBlock x:Name="AvatarInitialsText" Text="U" FontSize="30" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="AvatarImage" Stretch="UniformToFill" IsVisible="False"/>
              </Grid>
            </Border>
          </Button>
          <TextBlock x:Name="UserNameText" Text="Signed in" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="#DC2626" VerticalAlignment="Center"/>
            <TextBlock Text="Online" FontSize="11" Foreground="#DC2626"/>
          </StackPanel>
          <TextBlock x:Name="UserRoleText" Text="" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Logout -->
        <Button DockPanel.Dock="Bottom"
                x:Name="LogoutButton"
                Content="⏻  Log Out"
                Margin="16,0,16,20"
                Height="40"
                Background="#1E293B"
                Foreground="White"
                CornerRadius="8"
                HorizontalContentAlignment="Left"
                Padding="14,0"
                HorizontalAlignment="Stretch"/>

        <!-- Quick POS -->
        <Button DockPanel.Dock="Bottom" x:Name="QuickPosButton"
                Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                HorizontalContentAlignment="Center" Padding="0,10" CornerRadius="8"
                HorizontalAlignment="Stretch" Margin="16,0,16,20" Cursor="Hand">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Path Data="M7 4h-2l-1 2h-2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2h-11.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1h-14.34l-.94-2zm3.5 15c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2zm9 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                  Fill="Black" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>
            <TextBlock Text="Quick POS" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>


        <!-- Nav -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,8,12,0" Spacing="4">
          <Button x:Name="DashboardButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#3B82F6" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M3,13 L3,21 L10,21 L10,13 Z M3,3 L3,10 L10,10 L10,3 Z M14,3 L14,21 L21,21 L21,3 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="InventoryButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#10B981" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M20,7 L12,3 L4,7 L4,17 L12,21 L20,17 Z M12,3 L12,21 M4,7 L20,7"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Inventory" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="CategoriesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#8B5CF6" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M3,3 L9,3 L9,9 L3,9 Z M15,3 L21,3 L21,9 L15,9 Z M3,15 L9,15 L9,21 L3,21 Z M15,15 L21,15 L21,21 L15,21 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Categories" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="SuppliersButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#F59E0B" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M1,3 L15,3 L15,13 L1,13 Z M15,8 L19,8 L23,13 L23,17 L15,17 Z M5,17 C5,18.1 4.1,19 3,19 C1.9,19 1,18.1 1,17 C1,15.9 1.9,15 3,15 C4.1,15 5,15.9 5,17 Z M21,17 C21,18.1 20.1,19 19,19 C17.9,19 17,18.1 17,17 C17,15.9 17.9,15 19,15 C20.1,15 21,15.9 21,17 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Suppliers" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="PurchasesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EC4899" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M2,3 L4,3 L5,13 C5,13.6 5.4,14 6,14 L17,14 C17.6,14 18,13.6 18,13 L19,6 L5.5,6 M7,18 C7.6,18 8,18.4 8,19 C8,19.6 7.6,20 7,20 C6.4,20 6,19.6 6,19 C6,18.4 6.4,18 7,18 Z M16,18 C16.6,18 17,18.4 17,19 C17,19.6 16.6,20 16,20 C15.4,20 15,19.6 15,19 C15,18.4 15.4,18 16,18 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Purchases  ▾" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel x:Name="PurchasesSubPanel" IsVisible="False" Spacing="2" Margin="18,0,0,0">
            <Button x:Name="NewPurchaseButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#EC4899" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M12,7 L12,17 M7,12 L17,12"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Purchase Orders" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="ReceivedGoodsButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#EC4899" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M3,8 L12,3 L21,8 L21,17 L12,22 L3,17 Z M3,8 L12,13 L21,8 M12,13 L12,22"/>
                  </Canvas>
                </Viewbox>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Received" VerticalAlignment="Center"/>
                  <Border x:Name="PendingReceivingBadge" Background="#F59E0B" CornerRadius="8" Padding="5,1" IsVisible="False">
                    <TextBlock x:Name="PendingReceivingBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Button>
            <Button x:Name="PurchaseHistoryButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#EC4899" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 Z M14,2 L14,8 L20,8 M16,13 L8,13 M16,17 L8,17 M10,9 L8,9"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Supplier Bills" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="PurchaseInvoicesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#EC4899" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M6,2 L18,2 L18,22 L15,20 L12,22 L9,20 L6,22 Z M9,7 L15,7 M9,11 L15,11 M9,15 L13,15"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Supplier Payments" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="PurchaseReportsButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#EC4899" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M18,20 L18,10 M12,20 L12,4 M6,20 L6,14"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Purchase Reports" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Button x:Name="PosButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M6,2 L3,6 L3,20 C3,21.1 3.9,22 5,22 L19,22 C20.1,22 21,21.1 21,20 L21,6 L18,2 Z M3,6 L21,6 M16,10 C16,12.2 14.2,14 12,14 C9.8,14 8,12.2 8,10"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Sales / POS  ▾" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel x:Name="PosSubPanel" IsVisible="False" Spacing="2" Margin="18,0,0,0">
            <Button x:Name="PointOfSaleButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M4,4 L20,4 L20,16 L4,16 Z M8,20 L16,20 M12,16 L12,20 M7,8 L17,8 M7,12 L13,12"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Point of Sale" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
            <Button x:Name="SalesHistoryButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 Z M14,2 L14,8 L20,8 M16,13 L8,13 M16,17 L8,17 M10,9 L8,9"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Sales History" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
            <Button x:Name="CreditSalesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M21,4 L3,4 C1.9,4 1,4.9 1,6 L1,18 C1,19.1 1.9,20 3,20 L21,20 C22.1,20 23,19.1 23,18 L23,6 C23,4.9 22.1,4 21,4 Z M1,10 L23,10"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Credit Sales" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
            <Button x:Name="DailyClosingButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M12,1 L3,5 L3,11 C3,16.5 6.8,21.7 12,23 C17.2,21.7 21,16.5 21,11 L21,5 Z M9,12 L11,14 L15,10"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Daily Closing" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
            <Button x:Name="SalesReturnButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M9,14 L4,9 L9,4 M4,9 L15,9 C18,9 20,11 20,14 C20,17 18,19 15,19 L11,19"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Sales Returns" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          </StackPanel>
          <Button x:Name="CustomersButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#06B6D4" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M17,21 L17,19 C17,16.8 15.2,15 13,15 L5,15 C2.8,15 1,16.8 1,19 L1,21 M9,11 C11.2,11 13,9.2 13,7 C13,4.8 11.2,3 9,3 C6.8,3 5,4.8 5,7 C5,9.2 6.8,11 9,11 Z M23,21 L23,19 C23,17.1 21.7,15.5 20,15.1 M16,3.1 C17.7,3.5 19,5.1 19,7 C19,8.9 17.7,10.5 16,10.9"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Customers" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="AccountingButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#F97316" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M12,6 L12,12 L16,14"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Accounting  ▾" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel x:Name="AccountingSubPanel" IsVisible="False" Spacing="2" Margin="18,0,0,0">
            <Button x:Name="AccOverviewButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M3,13 L3,21 L10,21 L10,13 Z M3,3 L3,10 L10,10 L10,3 Z M14,3 L14,21 L21,21 L21,3 Z"/></Canvas></Viewbox>
                <TextBlock Text="Overview" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccIncomeButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M12,1 L12,23 M17,5 C17,3 15,2 12,2 C9,2 7,3.5 7,6 C7,8.5 9,9.5 12,10 C15,10.5 17,11.5 17,14 C17,16.5 15,18 12,18 C9,18 7,17 7,15"/></Canvas></Viewbox>
                <TextBlock Text="Income" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccExpensesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M8,12 L16,12 M12,8 L12,16"/></Canvas></Viewbox>
                <TextBlock Text="Expenses" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccReceivablesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M17,21 L17,19 C17,16.8 15.2,15 13,15 L5,15 C2.8,15 1,16.8 1,19 L1,21 M9,11 C11.2,11 13,9.2 13,7 C13,4.8 11.2,3 9,3 C6.8,3 5,4.8 5,7 C5,9.2 6.8,11 9,11 Z M23,21 L23,19 C23,17.1 21.7,15.5 20,15.1 M16,3.1 C17.7,3.5 19,5.1 19,7 C19,8.9 17.7,10.5 16,10.9"/></Canvas></Viewbox>
                <TextBlock Text="Receivables" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccPayablesButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M21,4 L3,4 C1.9,4 1,4.9 1,6 L1,18 C1,19.1 1.9,20 3,20 L21,20 C22.1,20 23,19.1 23,18 L23,6 C23,4.9 22.1,4 21,4 Z M1,10 L23,10"/></Canvas></Viewbox>
                <TextBlock Text="Payables" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccCashFlowButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M18,20 L18,10 M12,20 L12,4 M6,20 L6,14"/></Canvas></Viewbox>
                <TextBlock Text="Cash Flow" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccPLButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M3,3 L3,21 L21,21 M7,16 L11,10 L15,13 L19,7"/></Canvas></Viewbox>
                <TextBlock Text="Profit &amp; Loss" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="AccReportsButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="#F97316" StrokeThickness="1.8" Fill="Transparent" Data="M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 Z M14,2 L14,8 L20,8 M16,13 L8,13 M16,17 L8,17 M10,9 L8,9"/></Canvas></Viewbox>
                <TextBlock Text="Financial Reports" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Button x:Name="SettingsButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#64748B" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M12,15 C13.7,15 15,13.7 15,12 C15,10.3 13.7,9 12,9 C10.3,9 9,10.3 9,12 C9,13.7 10.3,15 12,15 Z M19.4,15 C19.2,15.5 19.3,16.1 19.7,16.5 L19.8,16.6 C20.1,16.9 20.3,17.3 20.3,17.7 C20.3,18.1 20.1,18.5 19.8,18.8 C19.5,19.1 19.1,19.3 18.7,19.3 C18.3,19.3 17.9,19.1 17.6,18.8 L17.5,18.7 C17.1,18.3 16.5,18.2 16,18.4 C15.5,18.6 15.2,19.1 15.2,19.6 L15.2,19.8 C15.2,20.7 14.5,21.4 13.6,21.4 L12.4,21.4 C11.5,21.4 10.8,20.7 10.8,19.8 L10.8,19.6 C10.8,19.1 10.5,18.6 10,18.4 C9.5,18.2 8.9,18.3 8.5,18.7 L8.4,18.8 C8.1,19.1 7.7,19.3 7.3,19.3 C6.9,19.3 6.5,19.1 6.2,18.8 C5.6,18.2 5.6,17.2 6.2,16.6 L6.3,16.5 C6.7,16.1 6.8,15.5 6.6,15 C6.4,14.5 5.9,14.2 5.4,14.2 L5.2,14.2 C4.3,14.2 3.6,13.5 3.6,12.6 L3.6,11.4 C3.6,10.5 4.3,9.8 5.2,9.8 L5.4,9.8 C5.9,9.8 6.4,9.5 6.6,9 C6.8,8.5 6.7,7.9 6.3,7.5 L6.2,7.4 C5.6,6.8 5.6,5.8 6.2,5.2 C6.8,4.6 7.8,4.6 8.4,5.2 L8.5,5.3 C8.9,5.7 9.5,5.8 10,5.6 C10.5,5.4 10.8,4.9 10.8,4.4 L10.8,4.2 C10.8,3.3 11.5,2.6 12.4,2.6 L13.6,2.6 C14.5,2.6 15.2,3.3 15.2,4.2 L15.2,4.4 C15.2,4.9 15.5,5.4 16,5.6 C16.5,5.8 17.1,5.7 17.5,5.3 L17.6,5.2 C18.2,4.6 19.2,4.6 19.8,5.2 C20.4,5.8 20.4,6.8 19.8,7.4 L19.7,7.5 C19.3,7.9 19.2,8.5 19.4,9 C19.6,9.5 20.1,9.8 20.6,9.8 L20.8,9.8 C21.7,9.8 22.4,10.5 22.4,11.4 L22.4,12.6 C22.4,13.5 21.7,14.2 20.8,14.2 L20.6,14.2 C20.1,14.2 19.6,14.5 19.4,15 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Settings" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="UsersButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#A855F7" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M20,21 L20,19 C20,16.8 18.2,15 16,15 L8,15 C5.8,15 4,16.8 4,19 L4,21 M12,11 C14.2,11 16,9.2 16,7 C16,4.8 14.2,3 12,3 C9.8,3 8,4.8 8,7 C8,9.2 9.8,11 12,11 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Users  ▾" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel x:Name="UsersSubPanel" IsVisible="False" Spacing="2" Margin="18,0,0,0">
            <Button x:Name="AllUsersButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#A855F7" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M17,20 L17,18 C17,15.8 15.2,14 13,14 L5,14 C2.8,14 1,15.8 1,18 L1,20 M9,10 C11.2,10 13,8.2 13,6 C13,3.8 11.2,2 9,2 C6.8,2 5,3.8 5,6 C5,8.2 6.8,10 9,10 Z M23,20 L23,18 C23,16.1 21.7,14.6 20,14.1 M16,2.1 C17.7,2.6 19,4.1 19,6 C19,7.9 17.7,9.4 16,9.9"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="All Users" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="UserActivityButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" CornerRadius="8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="#A855F7" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Data="M12 6 L12 12 L16 14 M21,12 C21,16.97 16.97,21 12,21 C7.03,21 3,16.97 3,12 C3,7.03 7.03,3 12,3 C16.97,3 21,7.03 21,12 Z"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="User Activities" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Button x:Name="PendingApprovalsButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Stroke="#EAB308" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Data="M9,12 L11,14 L15,10 M12,2 L3,7 L3,12 C3,16.5 7,20.9 12,22 C17,20.9 21,16.5 21,12 L21,7 Z"/>
                </Canvas>
              </Viewbox>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Approvals" VerticalAlignment="Center"/>
                <Border x:Name="ApprovalsBadge" Background="#F59E0B" CornerRadius="8" Padding="5,1" IsVisible="False">
                  <TextBlock x:Name="ApprovalsBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="MyStatusButton" Classes="navBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" CornerRadius="8" FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📋" FontSize="16"/>
              <TextBlock Text="My Status" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <!-- RIGHT SIDE: HEADER + MAIN CONTENT -->
    <Grid Grid.Column="1" RowDefinitions="56,*">

      <!-- HEADER -->
      <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <TextBlock x:Name="PageTitleText" Grid.Column="0" Text="Dashboard"
                     FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

          <Grid Grid.Column="1" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox x:Name="GlobalSearchBox" Watermark="🔍 Search medicines, invoices, customers..."
                     Padding="10,6" CornerRadius="8" Background="#F1F5F9" BorderThickness="0"/>
            <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding #GlobalSearchBox}"
                   Placement="Bottom" IsLightDismissEnabled="True" Width="360">
              <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                      Margin="0,4,0,0" MaxHeight="360" BoxShadow="0 4 12 0 #22000000">
                <ScrollViewer MaxHeight="360">
                  <ItemsControl x:Name="SearchResultsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SearchResultItem">
                        <Button Command="{Binding NavigateCommand}" Background="Transparent"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,8" CornerRadius="0" Cursor="Hand">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Icon}" FontSize="14"/>
                            <StackPanel Spacing="0">
                              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

            <!-- Notification bell -->
            <Button x:Name="NotifButton" Background="Transparent" Padding="4" Cursor="Hand">
              <Panel>
                <TextBlock Text="🔔" FontSize="18"/>
                <Border x:Name="NotifBadge" Background="#EF4444" CornerRadius="8"
                        Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-4,-4,0" IsVisible="False">
                  <TextBlock x:Name="NotifCountText" Text="0" FontSize="9" FontWeight="Bold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Panel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="320" Spacing="10">
                    <TextBlock x:Name="NotifHeaderText" Text="🔔 Notifications" FontWeight="Bold" FontSize="14"/>
                    <Separator/>

                    <StackPanel x:Name="NotifCriticalSection" Spacing="6">
                      <TextBlock Text="🔴 Critical" FontWeight="SemiBold" FontSize="12" Foreground="#EF4444"/>
                      <Button x:Name="NotifExpiredButton" Classes="notifRow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False">
                        <TextBlock x:Name="NotifExpiredText" Text="⚠ 0 medicines have expired" FontSize="12"/>
                      </Button>
                      <Button x:Name="NotifOutOfStockButton" Classes="notifRow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False">
                        <TextBlock x:Name="NotifOutOfStockText" Text="⚠ 0 medicines are out of stock" FontSize="12"/>
                      </Button>
                    </StackPanel>

                    <StackPanel x:Name="NotifWarningSection" Spacing="6">
                      <TextBlock Text="🟠 Warnings" FontWeight="SemiBold" FontSize="12" Foreground="#F59E0B"/>
                      <Button x:Name="NotifLowStockButton" Classes="notifRow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False">
                        <TextBlock x:Name="NotifLowStockText" Text="📦 0 medicines are low stock" FontSize="12"/>
                      </Button>
                      <Button x:Name="NotifExpiringButton" Classes="notifRow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False">
                        <TextBlock x:Name="NotifExpiringText" Text="⏳ 0 medicines expire within 30 days" FontSize="12"/>
                      </Button>
                    </StackPanel>

                    <StackPanel x:Name="NotifBusinessSection" Spacing="6">
                      <TextBlock Text="🟢 Business" FontWeight="SemiBold" FontSize="12" Foreground="#DC2626"/>
                      <TextBlock x:Name="NotifRevenueText" Text="💰 Today's sales: $0.00" FontSize="12" Margin="8,4"/>
                      <Button x:Name="NotifNewCustomersButton" Classes="notifRow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False">
                        <TextBlock x:Name="NotifNewCustomersText" Text="👥 0 new customers today" FontSize="12"/>
                      </Button>
                    </StackPanel>

                    <TextBlock x:Name="NotifEmptyText" Text="✅ No alerts right now" FontSize="12" Foreground="#64748B" IsVisible="False"/>
                    <Separator/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button x:Name="SettingsQuickButton" Content="⚙" Background="Transparent" Padding="4" Cursor="Hand"/>

            <!-- User menu -->
            <Button x:Name="UserMenuButton" Background="Transparent" Padding="6,4" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Avatar circle -->
                <Border Width="34" Height="34" CornerRadius="17" Background="#DC2626">
                  <Panel>
                    <TextBlock x:Name="HeaderAvatarInitials" Text="U"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="HeaderAvatarImage" Stretch="UniformToFill"
                           IsVisible="False" ClipToBounds="True"/>
                  </Panel>
                </Border>
                <!-- Name + role -->
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock x:Name="HeaderUserName" Text="User"
                             FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                  <TextBlock x:Name="HeaderUserRole" Text="Role"
                             FontSize="10" Foreground="#64748B"/>
                </StackPanel>
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="260" Spacing="0">
                    <!-- Profile card -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#DC2626">
                          <TextBlock x:Name="FlyoutAvatarInitials" Text="U"
                                     FontSize="16" FontWeight="Bold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock x:Name="MenuUserName" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                          <TextBlock x:Name="MenuUserRole" FontSize="11" Foreground="#64748B"/>
                          <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <TextBlock Text="● Online" FontSize="10" Foreground="#16A34A" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <!-- Info rows -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="👤" FontSize="12" VerticalAlignment="Center"/>
                          <StackPanel>
                            <TextBlock Text="Full Name" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock x:Name="FlyoutFullName" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="🛡" FontSize="12" VerticalAlignment="Center"/>
                          <StackPanel>
                            <TextBlock Text="Role" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock x:Name="FlyoutRole" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold"/>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="🕐" FontSize="12" VerticalAlignment="Center"/>
                          <StackPanel>
                            <TextBlock Text="Session started" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock x:Name="FlyoutSessionTime" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Separator Margin="0,0,0,6"/>
                    <Button x:Name="MenuPreferencesButton" Content="⚙  Preferences" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="8,6"/>
                    <Separator Margin="0,4"/>
                    <Button x:Name="MenuLogoutButton" Content="⏻  Logout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#EF4444" Padding="8,6"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

          </StackPanel>
        </Grid>
      </Border>

      <!-- MAIN CONTENT -->
      <Border Grid.Row="1" Background="{DynamicResource BrandBackgroundBrush}">
        <ContentControl x:Name="MainContent"/>
      </Border>

    </Grid>

  </Grid>

  <!-- ===== Toast overlay ===== -->
  <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,20,20,0" Spacing="10" Width="340"/>

  </Panel>
</Window>
