<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Shared.PaymentDialog"
        Width="360" Height="220" WindowStartupLocation="CenterOwner"
        CanResize="False" Background="White"
        Title="Record Payment">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="14" Foreground="#0F172A"/>
    <StackPanel Spacing="4">
      <TextBlock Text="Payment Amount" FontSize="12" Foreground="#64748B"/>
      <TextBox x:Name="AmountBox" Height="38"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" IsVisible="False"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="34" Background="#E2E8F0" Foreground="#334155" CornerRadius="6"/>
      <Button x:Name="ConfirmButton" Content="Record" Width="90" Height="34" Background="#22C55E" Foreground="White" CornerRadius="6"/>
    </StackPanel>
  </StackPanel>
</Window>
