<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:ent="clr-namespace:PharmacyMS.Domain.Entities;assembly=PharmacyMS.Domain"
             xmlns:conv="clr-namespace:PharmacyMS.Desktop.Converters"
             x:Class="PharmacyMS.Desktop.Views.Approvals.MySubmissionsView"
             x:DataType="vm:MySubmissionsViewModel"
             Background="#F1F5F9">
  <UserControl.Resources>
    <conv:ApprovalStatusToBrushConverter x:Key="StatusBrush"/>
  </UserControl.Resources>
  <ScrollViewer>
  <StackPanel Margin="24" Spacing="20">

    <TextBlock Text="My Submission Status" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
    <TextBlock Text="Track the status of everything you've submitted for approval." FontSize="13" Foreground="#64748B"/>

    <!-- Customers -->
    <Border Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #22000000">
      <StackPanel Spacing="10">
        <TextBlock Text="👤 Customers" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
        <DataGrid x:Name="CustomersGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:Customer" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
            <DataGridTextColumn Header="Submitted" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
            <DataGridTemplateColumn Header="Status" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="ent:Customer">
                  <Border Background="{Binding ApprovalStatus, Converter={StaticResource StatusBrush}}"
                          CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ApprovalStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoCustomersText" Text="You haven't submitted any customers yet" Foreground="#64748B" FontSize="13" IsVisible="False"/>
      </StackPanel>
    </Border>

    <!-- Suppliers -->
    <Border Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #22000000">
      <StackPanel Spacing="10">
        <TextBlock Text="🚚 Suppliers" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
        <DataGrid x:Name="SuppliersGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:Supplier" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
            <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="140"/>
            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
            <DataGridTextColumn Header="Submitted" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
            <DataGridTemplateColumn Header="Status" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="ent:Supplier">
                  <Border Background="{Binding ApprovalStatus, Converter={StaticResource StatusBrush}}"
                          CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ApprovalStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoSuppliersText" Text="You haven't submitted any suppliers yet" Foreground="#64748B" FontSize="13" IsVisible="False"/>
      </StackPanel>
    </Border>

    <!-- Sale Payments -->
    <Border Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #22000000">
      <StackPanel Spacing="10">
        <TextBlock Text="💵 Sale Payments" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
        <DataGrid x:Name="PaymentsGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:PendingSalePayment" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Sale #" Binding="{Binding SaleId}" Width="70"/>
            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160"/>
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}${0:F2}'}" Width="100"/>
            <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
            <DataGridTemplateColumn Header="Status" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="ent:PendingSalePayment">
                  <Border Background="{Binding ApprovalStatus, Converter={StaticResource StatusBrush}}"
                          CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ApprovalStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Reason (if rejected)" Binding="{Binding RejectionReason}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoPaymentsText" Text="You haven't submitted any payments yet" Foreground="#64748B" FontSize="13" IsVisible="False"/>
      </StackPanel>
    </Border>

    <!-- Expenses -->
    <Border Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #22000000">
      <StackPanel Spacing="10">
        <TextBlock Text="💸 Expenses" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
        <DataGrid x:Name="ExpensesGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:PendingExpense" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="180"/>
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}${0:F2}'}" Width="90"/>
            <DataGridTemplateColumn Header="Status" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="ent:PendingExpense">
                  <Border Background="{Binding ApprovalStatus, Converter={StaticResource StatusBrush}}"
                          CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ApprovalStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Reason (if rejected)" Binding="{Binding RejectionReason}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoExpensesText" Text="You haven't submitted any expenses yet" Foreground="#64748B" FontSize="13" IsVisible="False"/>
      </StackPanel>
    </Border>

    <!-- Stock Receiving -->
    <Border Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #22000000">
      <StackPanel Spacing="10">
        <TextBlock Text="📥 Stock Receiving" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
        <DataGrid x:Name="ReceiptsGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:GoodsReceipt" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" MaxHeight="260">
          <DataGrid.Columns>
            <DataGridTextColumn Header="PO #" Binding="{Binding PurchaseOrderId}" Width="70"/>
            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='{}${0:F2}'}" Width="90"/>
            <DataGridTemplateColumn Header="Status" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="ent:GoodsReceipt">
                  <Border Background="{Binding ApprovalStatus, Converter={StaticResource StatusBrush}}"
                          CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ApprovalStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Reason (if rejected)" Binding="{Binding RejectionReason}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="NoReceiptsText" Text="You haven't submitted any stock receipts yet" Foreground="#64748B" FontSize="13" IsVisible="False"/>
      </StackPanel>
    </Border>

  </StackPanel>
  </ScrollViewer>
</UserControl>
