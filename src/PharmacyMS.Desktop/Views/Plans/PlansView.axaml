<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharmacyMS.Desktop.Views.Plans.PlansView">
  <Grid RowDefinitions="48,*" ColumnDefinitions="360,*">

    <!-- Top Red Header Bar -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#991B1B">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
        <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png" Width="26" Height="26"/>
        <TextBlock Text="PharmaPro" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Left Sidebar (same 360px width as License Setup screen) -->
    <Grid Grid.Row="1" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="150"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" Padding="30,40,30,20">
        <StackPanel Spacing="0">
          <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
                 Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,14"/>
          <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="Pharma" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Pro" FontSize="28" FontWeight="Bold" Foreground="#B91C1C"/>
          </StackPanel>
          <TextBlock Text="Pharmacy Management System" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
          <Border Height="2" Width="70" Background="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock Text="Smart Pharmacy." FontSize="14" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center"/>
          <TextBlock Text="Stronger Business." FontSize="14" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,26"/>

          <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Background="#FEE2E2" CornerRadius="24" Width="48" Height="48">
                <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M12,1 L3,5 L3,11 C3,16.5 7,21.7 12,23 C17,21.7 21,16.5 21,11 L21,5 Z"
                      Width="22" Height="22" Stretch="Uniform"/>
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Secure &amp; Reliable" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="Your data is safe and always protected." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Background="#FEE2E2" CornerRadius="24" Width="48" Height="48">
                <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M13,2 L3,14 L11,14 L9,22 L21,10 L13,10 Z"
                      Width="22" Height="22" Stretch="Uniform"/>
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Powerful Features" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="Everything you need to run your pharmacy." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Background="#FEE2E2" CornerRadius="24" Width="48" Height="48">
                <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M13,17 L11,17 L11,11 L13,11 Z M13,9 L11,9 L11,7 L13,7 Z"
                      Width="22" Height="22" Stretch="Uniform"/>
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Priority Support" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="We're here to help every step of the way." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Red bottom with curve -->
      <Grid Grid.Row="1">
        <Border Background="#B91C1C"/>
        <Canvas ClipToBounds="True" Height="150">
          <Path Fill="White" Data="M 0,0 Q 180,60 360,0 L 360,-10 L 0,-10 Z"/>
        </Canvas>
        <Border Background="White" CornerRadius="20" Padding="18,10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="#B91C1C" CornerRadius="10" Width="20" Height="20">
              <Path Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z"
                    Width="12" Height="12" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="No hidden fees. Cancel anytime." FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Right Content -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
      <StackPanel Margin="48,40,48,40" Spacing="32">

        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center">
            <TextBlock Text="Choose the " FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Plan" FontSize="28" FontWeight="Bold" Foreground="#B91C1C"/>
            <TextBlock Text=" That Works for You" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
          </StackPanel>
          <TextBlock Text="Flexible plans for pharmacies of all sizes." FontSize="13.5" Foreground="#64748B" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Plan Cards -->
        <Grid ColumnDefinitions="*,20,*,20,*">

          <!-- Card A: Trial -->
          <Border Grid.Column="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="16" Padding="24,32,24,24" VerticalAlignment="Top">
            <StackPanel Spacing="0">
              <Border Background="#B91C1C" CornerRadius="24" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="A" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Trial Plan" FontSize="18" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock Text="Try PharmaPro risk-free" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,18"/>

              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="1" FontSize="34" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Month" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
              </StackPanel>
              <TextBlock Text="Free Trial" FontSize="14" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,18"/>

              <Border Height="1" Background="#FECACA" Margin="0,0,0,18"/>

              <StackPanel Spacing="12" Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Full access to all features" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Up to 1 User" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Standard Support" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="No credit card required" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>

              <Button x:Name="StartTrialButton" Content="Start Free Trial" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Padding="0,12" Background="#FEE2E2" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="13"
                      CornerRadius="8" BorderThickness="0" Click="OnStartTrialClick"/>
              <TextBlock x:Name="TrialFootnoteText" Text="No commitment. Cancel anytime." FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- Card B: Monthly (highlighted) -->
          <Grid Grid.Column="2" VerticalAlignment="Top" RowDefinitions="Auto,Auto">
            <Border Grid.Row="0" Background="#B91C1C" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,-14" ZIndex="1">
              <TextBlock Text="MOST POPULAR" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#B91C1C" BorderThickness="2" CornerRadius="16" Padding="24,34,24,24">
              <StackPanel Spacing="0">
                <Border Background="#B91C1C" CornerRadius="24" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,14">
                  <TextBlock Text="B" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Monthly Plan" FontSize="19" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Pay monthly, cancel anytime" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="$10" FontSize="38" FontWeight="Bold" Foreground="#0F172A"/>
                  <TextBlock Text="/mo." FontSize="15" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>
                <TextBlock Text="Billed monthly" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <Border Height="1" Background="#FECACA" Margin="0,0,0,18"/>

                <StackPanel Spacing="12" Margin="0,0,0,28">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                      <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Full access to all features" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                      <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Up to 3 Users" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                      <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Regular Updates" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                      <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Priority Email Support" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                      <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Data Backup &amp; Security" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <Button Content="Choose Monthly Plan" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,13" Background="#B91C1C" Foreground="White" FontWeight="SemiBold" FontSize="13"
                        CornerRadius="8" BorderThickness="0" Click="OnChooseMonthlyClick"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Card C: Annual -->
          <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="16" Padding="24,32,24,24" VerticalAlignment="Top">
            <StackPanel Spacing="0">
              <Border Background="#B91C1C" CornerRadius="24" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="C" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Annual Plan" FontSize="18" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock Text="Best value for your pharmacy" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,18"/>

              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="$100" FontSize="34" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="/yr." FontSize="15" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
              </StackPanel>
              <TextBlock Text="Save $20 (17%)" FontSize="13" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,18"/>

              <Border Height="1" Background="#FECACA" Margin="0,0,0,18"/>

              <StackPanel Spacing="12" Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Full access to all features" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Up to 5 Users" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Regular Updates" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Priority Support" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Data Backup &amp; Security" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Background="#FEE2E2" CornerRadius="10" Width="20" Height="20">
                    <Path Fill="#B91C1C" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Best value - Save more!" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>

              <Button Content="Choose Annual Plan" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Padding="0,12" Background="#FEE2E2" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="13"
                      CornerRadius="8" BorderThickness="0" Click="OnChooseAnnualClick"/>
            </StackPanel>
          </Border>

        </Grid>

        <!-- Feature strip -->
        <Grid ColumnDefinitions="*,*,*,*" Margin="0,8,0,0">
          <StackPanel Grid.Column="0" Spacing="10" HorizontalAlignment="Center" Margin="0,0,12,0">
            <Border Background="#FEE2E2" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,4">
              <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M7,2 L7,4 L5,4 C3.9,4 3,4.9 3,6 L3,20 C3,21.1 3.9,22 5,22 L19,22 C20.1,22 21,21.1 21,20 L21,6 C21,4.9 20.1,4 19,4 L17,4 L17,2 L15,2 L15,4 L9,4 L9,2 Z M5,9 L19,9 L19,20 L5,20 Z"
                    Width="20" Height="20" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Easy to Get Started" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Choose a plan and start managing your pharmacy in minutes." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="220"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Center" Margin="0,0,12,0">
            <Border Background="#FEE2E2" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,4">
              <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M13,17 L11,17 L11,11 L13,11 Z M13,9 L11,9 L11,7 L13,7 Z"
                    Width="20" Height="20" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Cancel Anytime" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Upgrade, downgrade, or cancel your plan anytime with no hassle." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="220"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="10" HorizontalAlignment="Center" Margin="0,0,12,0">
            <Border Background="#FEE2E2" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,4">
              <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M12,1 C9.24,1 7,3.24 7,6 L7,8 L6,8 C4.9,8 4,8.9 4,10 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,10 C20,8.9 19.1,8 18,8 L17,8 L17,6 C17,3.24 14.76,1 12,1 Z M9,6 C9,4.34 10.34,3 12,3 C13.66,3 15,4.34 15,6 L15,8 L9,8 Z"
                    Width="20" Height="20" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Secure Payments" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="All payments are encrypted and processed securely through trusted partners." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="220"/>
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="10" HorizontalAlignment="Center">
            <Border Background="#FEE2E2" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,4">
              <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M12,1 L3,5 L3,11 C3,16.5 7,21.7 12,23 C17,21.7 21,16.5 21,11 L21,5 Z"
                    Width="20" Height="20" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="30-Day Money Back" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Not satisfied? Get a full refund within 30 days of your purchase." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="220"/>
          </StackPanel>
        </Grid>

        <!-- Footer -->
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Background="#FEE2E2" CornerRadius="10" Width="18" Height="18">
              <Path Fill="#B91C1C" Data="M12,1 L3,5 L3,11 C3,16.5 7,21.7 12,23 C17,21.7 21,16.5 21,11 L21,5 Z" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Your data is 100% secure with PharmaPro." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="|" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Need help?" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
            <TextBlock Text="Contact our support team." FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
