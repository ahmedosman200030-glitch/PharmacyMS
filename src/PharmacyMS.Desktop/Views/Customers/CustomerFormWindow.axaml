<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Customers.CustomerFormWindow"
        Title="Customer"
        Width="380" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Name" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="NameBox" Height="36"/>

    <TextBlock Text="Phone" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="PhoneBox" Height="36"/>

    <TextBlock Text="Email" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="EmailBox" Height="36"/>

    <TextBlock Text="Address" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="AddressBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

    <TextBlock x:Name="ErrorText" Foreground="#F09595" FontSize="12" IsVisible="False"/>

    <Button x:Name="SaveButton" Content="Save" Height="42" Margin="0,10,0,0"
            Background="#1D9E75" Foreground="White" CornerRadius="8"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
  </StackPanel>
</Window>
