<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PharmacyMS.Desktop.Views.Auth.LoginView"
        Title="PharmaPro — Sign In"
        MinWidth="1100" MinHeight="650" WindowState="Normal"
        
        Background="White">

  <Border Background="White"
          CornerRadius="0"
          
          Margin="0"
          
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">
    <Grid RowDefinitions="*">
      <!-- BODY -->
      <Grid Grid.Row="0" ColumnDefinitions="1.15*,620" MinHeight="660">

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" CornerRadius="0,60,60,0" ClipToBounds="True">
          <Grid>
            <!-- Background photo -->
            <Image Source="avares://PharmacyMS.Desktop/Assets/pharmacy.jpg"
                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Dark red overlay -->
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#EE6B0000" Offset="0"/>
                  <GradientStop Color="#EE991B1B" Offset="0.5"/>
                  <GradientStop Color="#EE5C0000" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <Grid Margin="60,40,60,24" RowDefinitions="Auto,Auto,Auto,*">

              <!-- Logo + Title -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,0,10">
                <Border Width="90" Height="90" CornerRadius="18" Background="White" Padding="6"
                        BoxShadow="0 4 20 0 #60000000">
                  <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
                         Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock Text="Pharma" FontSize="34" FontWeight="ExtraBold" Foreground="White"/>
                    <TextBlock Text="Pro" FontSize="34" FontWeight="ExtraBold" Foreground="#FECACA"/>
                  </StackPanel>
                  <TextBlock Text="Smart Pharmacy Management" FontSize="13" Foreground="#FECACA"/>
                </StackPanel>
              </StackPanel>

              <!-- Divider + Description -->
              <StackPanel Grid.Row="1" Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,16" VerticalAlignment="Center">
                  <Border Height="1" Width="60" Background="#80FFFFFF" VerticalAlignment="Center"/>
                  <TextBlock Text="♥" Foreground="#FECACA" FontSize="14"/>
                  <Border Height="1" Width="60" Background="#80FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="#FECACA" LineHeight="22"
                           Text="PharmaPro is a complete solution to manage your pharmacy operations efficiently and grow your business."/>
              </StackPanel>

              <!-- 2-column feature grid -->
              <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12" VerticalAlignment="Top">

                <!-- Feature 1 -->
                <Border Grid.Row="0" Grid.Column="0" Background="#33FFFFFF" CornerRadius="10" Padding="14,12">
                  <StackPanel Spacing="8">
                    <Border Width="36" Height="36" Background="#40FFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                      <Path Data="M4.22 11.29l7.07-7.07a5 5 0 117.07 7.07l-7.07 7.07a5 5 0 01-7.07-7.07z"
                            Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <TextBlock Text="Manage Medicines &amp; Inventory" FontWeight="Bold" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Track stock in real-time, manage expiry dates and get low stock alerts." FontSize="11.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Feature 2 -->
                <Border Grid.Row="0" Grid.Column="1" Background="#33FFFFFF" CornerRadius="10" Padding="14,12">
                  <StackPanel Spacing="8">
                    <Border Width="36" Height="36" Background="#40FFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                      <Path Data="M7 4h-2l-1 2h-2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2h-11.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1h-14.34l-.94-2z"
                            Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <TextBlock Text="Fast &amp; Easy POS" FontWeight="Bold" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Speed up billing with barcode scan, multiple payment options and instant receipts." FontSize="11.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Feature 3 -->
                <Border Grid.Row="1" Grid.Column="0" Background="#33FFFFFF" CornerRadius="10" Padding="14,12">
                  <StackPanel Spacing="8">
                    <Border Width="36" Height="36" Background="#40FFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                      <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"
                            Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <TextBlock Text="Purchases &amp; Suppliers" FontWeight="Bold" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Manage purchases, supplier invoices and track payment dues easily." FontSize="11.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Feature 4 -->
                <Border Grid.Row="1" Grid.Column="1" Background="#33FFFFFF" CornerRadius="10" Padding="14,12">
                  <StackPanel Spacing="8">
                    <Border Width="36" Height="36" Background="#40FFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                      <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                            Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <TextBlock Text="Customers &amp; Credit" FontWeight="Bold" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Maintain customer profiles, track credit sales and collect payments." FontSize="11.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Feature 5 -->
                <Border Grid.Row="2" Grid.Column="0" Background="#33FFFFFF" CornerRadius="10" Padding="14,12">
                  <StackPanel Spacing="8">
                    <Border Width="36" Height="36" Background="#40FFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                      <Path Data="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"
                            Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <TextBlock Text="Powerful Reports" FontWeight="Bold" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Get detailed insights on sales, purchases, profit, stock and more." FontSize="11.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Feature 6 -->
                <Border Grid.Row="2" Grid.Column="1" Background="#33FFFFFF" CornerRadius="10" Padding="14,12">
                  <StackPanel Spacing="8">
                    <Border Width="36" Height="36" Background="#40FFFFFF" CornerRadius="8" HorizontalAlignment="Left">
                      <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z"
                            Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Border>
                    <TextBlock Text="Secure &amp; Reliable" FontWeight="Bold" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="Role-based access, data backup and secure your pharmacy data." FontSize="11.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

              </Grid>

              <!-- Support + Copyright -->
              <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="8" VerticalAlignment="Bottom">
                <Border Background="#33FFFFFF" CornerRadius="10" Padding="16,12">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="40" Height="40" Background="#40FFFFFF" CornerRadius="8" Grid.Column="0" Margin="0,0,12,0">
                      <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                            Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Need Help?" FontWeight="Bold" FontSize="13" Foreground="White"/>
                      <TextBlock Text="Our support team is here to help you." FontSize="11.5" Foreground="#FECACA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="📞 +252 63 4734969" FontSize="11.5" Foreground="White"/>
                      <TextBlock Text="✉ ahmedosman200030@gmail.com" FontSize="11.5" Foreground="White"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBlock Text="© 2026 PharmaPro. All rights reserved." FontSize="12" Foreground="#FECDD3"/>
              </StackPanel>

            </Grid>
          </Grid>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" Margin="60,40,60,22" RowDefinitions="*,Auto">

          <StackPanel Grid.Row="0" MaxWidth="400" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <Border Width="90" Height="90" CornerRadius="20"
                    Background="White" Padding="8"
                    BoxShadow="0 6 24 0 #80DC2626"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
              <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
                     Stretch="Uniform"/>
            </Border>

            <TextBlock Text="Welcome Back!" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A"
                       HorizontalAlignment="Stretch" Margin="0,0,0,5"/>
            <TextBlock Text="Login to access your PharmaPro account" FontSize="13.5" Foreground="#64748B"
                       HorizontalAlignment="Stretch" Margin="0,0,0,26"/>

            <TextBlock Text="Username" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0" Height="46" Margin="0,0,0,18">
              <Grid ColumnDefinitions="Auto,*" Margin="12,0">
                <TextBlock Grid.Column="0" Text="&#128100;" FontSize="14" Opacity="0.55" VerticalAlignment="Stretch" Margin="0,0,9,0"/>
                <TextBox x:Name="UsernameBox" Grid.Column="1" Watermark="Enter your username"
                          BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                          Padding="0" FontSize="14"/>
              </Grid>
            </Border>

            <TextBlock Text="Password" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0" Height="46" Margin="0,0,0,18">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                <TextBlock Grid.Column="0" Text="&#128274;" FontSize="14" Opacity="0.55" VerticalAlignment="Stretch" Margin="0,0,9,0"/>
                <TextBox x:Name="PasswordBox" Grid.Column="1" PasswordChar="●" Watermark="Enter your password"
                          BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                          Padding="0" FontSize="14"/>
                <Button x:Name="TogglePasswordButton" Grid.Column="2" Content="&#128065;" FontSize="14"
                        Background="Transparent" BorderThickness="0" Padding="0" Opacity="0.6"
                        VerticalAlignment="Stretch" Margin="9,0,0,0" Cursor="Hand"/>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Stretch">
                <CheckBox IsChecked="True" MinWidth="0" Padding="4,0,0,0"/>
                <TextBlock Text="Remember me" FontSize="13" Foreground="#334155" VerticalAlignment="Stretch"/>
              </StackPanel>
              <TextBlock x:Name="ForgotPasswordText" Grid.Column="1" Text="Forgot password?" FontSize="13" FontWeight="SemiBold"
                         Foreground="#DC2626" VerticalAlignment="Stretch" Cursor="Hand"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Text="" Foreground="#DC2626" FontSize="12.5"
                       IsVisible="False" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Border CornerRadius="0" Background="#DC2626" Height="48" Margin="0,0,0,22">
              <Button x:Name="LoginButton" Content="→ Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                      Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand"/>
            </Border>

            <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,20" VerticalAlignment="Stretch">
              <Border Grid.Column="0" Height="1" Background="#E2E8F0" VerticalAlignment="Stretch"/>
              <TextBlock Grid.Column="1" Text="or" FontSize="12" Foreground="#94A3B8" Margin="12,0"/>
              <Border Grid.Column="2" Height="1" Background="#E2E8F0" VerticalAlignment="Stretch"/>
            </Grid>

            <Grid ColumnDefinitions="*,*" Margin="0,0,0,24">
              <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0" Height="46" Margin="0,0,6,0">
                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Cursor="Hand">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Stretch">
                    <Path Data="M12 1C7.03 1 3 5.03 3 10c0 1.5.36 2.9 1 4.14V22h2v-2h2v-2h2v-2h6.34A9 9 0 0021 10c0-4.97-4.03-9-9-9zm0 2c3.87 0 7 3.13 7 7 0 1.06-.24 2.06-.66 2.96L18 13H10a5 5 0 110-2h5.35A6.98 6.98 0 0012 3z"
                          Fill="#6D28D9" Stretch="Uniform" Width="15" Height="15"/>
                    <TextBlock Text="Login with Biometrics" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                  </StackPanel>
                </Button>
              </Border>
              <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0" Height="46" Margin="6,0,0,0">
                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Cursor="Hand">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Stretch">
                    <Path Data="M12 1L4 4v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V4l-8-3zm0 10.99h6c-.49 4-3.4 7.55-6 8.94V12H6V5.3l6-2.25v8.94z"
                          Fill="#334155" Stretch="Uniform" Width="15" Height="15"/>
                    <TextBlock Text="Use PIN Code" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                  </StackPanel>
                </Button>
              </Border>
            </Grid>

            <TextBlock HorizontalAlignment="Stretch" FontSize="13" Foreground="#64748B">
              <Run Text="Don't have an account? "/>
              <Run Text="Contact Administrator" Foreground="#DC2626" FontWeight="SemiBold"/>
            </TextBlock>
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" Text="🌐 English (US)" FontSize="12" Foreground="#94A3B8"/>
            <TextBlock Grid.Column="1" Text="v2.0.0" FontSize="12" Foreground="#94A3B8"/>
          </Grid>
        </Grid>

      </Grid>
    </Grid>
  </Border>
</Window>
