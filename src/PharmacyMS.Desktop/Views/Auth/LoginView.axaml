<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Auth.LoginView"
        Title="Pharmacy — Sign In"
        Width="900" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#0A1628">

  <Grid ColumnDefinitions="*,360">

    <Border Grid.Column="0" Background="Transparent">
      <StackPanel Margin="40,40,32,40" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,48">
          <Border Width="44" Height="44" CornerRadius="10" Background="#1D9E75">
            <TextBlock Text="+" FontSize="28" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Pharmacy" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Management System" FontSize="11" Foreground="#66FFFFFF"/>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="Your pharmacy," FontSize="28" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="fully in control." FontSize="28" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,14"/>
        <TextBlock Text="Manage inventory, sales, suppliers and patients from one secure platform built for Somaliland pharmacies."
                   FontSize="13" Foreground="#88FFFFFF" TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,36"
                   LineHeight="22"/>

        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="32" Height="32" CornerRadius="8" Background="#14FFFFFF">
              <TextBlock Text="💊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Real-time inventory &amp; expiry tracking" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="32" Height="32" CornerRadius="8" Background="#14FFFFFF">
              <TextBlock Text="📈" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Daily revenue, profit &amp; sales reports" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="32" Height="32" CornerRadius="8" Background="#14FFFFFF">
              <TextBlock Text="🔒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Role-based access control &amp; audit trail" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="32" Height="32" CornerRadius="8" Background="#14FFFFFF">
              <TextBlock Text="🧾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="POS with QR receipts &amp; customer history" FontSize="13" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </Border>

    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="0,12,12,0">
      <StackPanel Margin="40" VerticalAlignment="Center" Spacing="0">

        <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,6"/>
        <TextBlock Text="Sign in to your account to continue"
                   FontSize="13" Foreground="#64748B" Margin="0,0,0,32"/>

        <TextBlock Text="Username" FontSize="12" FontWeight="Bold"
                   Foreground="#334155" Margin="0,0,0,6"/>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,18">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="👤" FontSize="14"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox Grid.Column="1" x:Name="UsernameBox"
                     Background="Transparent" BorderThickness="0"
                     Height="44" Padding="10,0"
                     FontSize="14" Foreground="#0F172A"
                     PlaceholderText="Enter your username"/>
          </Grid>
        </Border>

        <TextBlock Text="Password" FontSize="12" FontWeight="Bold"
                   Foreground="#334155" Margin="0,0,0,6"/>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="🔒" FontSize="14"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox Grid.Column="1" x:Name="PasswordBox"
                     Background="Transparent" BorderThickness="0"
                     Height="44" Padding="10,0"
                     FontSize="14" Foreground="#0F172A"
                     PasswordChar="●"
                     PlaceholderText="Enter your password"/>
            <Button Grid.Column="2" x:Name="TogglePasswordButton"
                    Content="👁" FontSize="14"
                    Background="Transparent" BorderThickness="0"
                    Width="40" Height="44" Padding="0"
                    Foreground="#64748B" Cursor="Hand"/>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,24">
          <CheckBox Grid.Column="0" x:Name="RememberMeBox"
                    Content="Remember me" FontSize="13" Foreground="#64748B"/>
          <TextBlock Grid.Column="1" x:Name="ForgotPasswordText" Text="Forgot password?"
                     FontSize="13" Foreground="#1D9E75"
                     VerticalAlignment="Center" Cursor="Hand"/>
        </Grid>

        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#EF4444"
                   IsVisible="False" Margin="0,0,0,14" TextWrapping="Wrap"/>

        <Button x:Name="LoginButton"
                Content="Sign in"
                Height="44"
                Background="#0F2A43"
                Foreground="White"
                FontSize="14"
                FontWeight="Bold"
                CornerRadius="8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
          <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                  CornerRadius="20" Padding="10,5">
            <TextBlock Text="✓ BCrypt auth" FontSize="11" Foreground="#166534"/>
          </Border>
          <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                  CornerRadius="20" Padding="10,5">
            <TextBlock Text="🔐 Offline &amp; secure" FontSize="11" Foreground="#166534"/>
          </Border>
        </StackPanel>

        <TextBlock Text="Pharmacy v1.0 · Created by Ahmed Osman"
                   FontSize="11" Foreground="#94A3B8"
                   HorizontalAlignment="Center" Margin="0,20,0,0"/>

      </StackPanel>
    </Border>

  </Grid>
</Window>
