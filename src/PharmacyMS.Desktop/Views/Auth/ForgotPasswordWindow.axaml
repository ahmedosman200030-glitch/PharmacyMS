<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Auth.ForgotPasswordWindow"
        Title="Reset Password" Width="380" Height="440"
        CanResize="False" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
  <StackPanel Margin="28" Spacing="10">
    <TextBlock Text="Reset Password" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
    <TextBlock x:Name="StepText" Text="Enter your username to continue."
               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <StackPanel x:Name="Step1Panel" Spacing="8">
      <TextBlock Text="Username" FontSize="12" Foreground="#334155"/>
      <TextBox x:Name="UsernameBox" Height="38"/>
      <Button x:Name="ContinueButton" Content="Continue" Height="40" Margin="0,10,0,0"
              Background="#0F2A43" Foreground="White" CornerRadius="8"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>

    <StackPanel x:Name="Step2Panel" Spacing="8" IsVisible="False">
      <TextBlock x:Name="QuestionText" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
      <TextBox x:Name="AnswerBox" Height="38" PlaceholderText="Your answer"/>
      <TextBlock Text="New Password" FontSize="12" Foreground="#334155" Margin="0,6,0,0"/>
      <TextBox x:Name="NewPasswordBox" Height="38" PasswordChar="●"/>
      <TextBlock Text="Confirm Password" FontSize="12" Foreground="#334155"/>
      <TextBox x:Name="ConfirmPasswordBox" Height="38" PasswordChar="●"/>
      <Button x:Name="ResetButton" Content="Reset Password" Height="40" Margin="0,10,0,0"
              Background="#DC2626" Foreground="White" CornerRadius="8"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
    <TextBlock x:Name="SuccessText" Foreground="#DC2626" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
    <Button x:Name="CloseButton" Content="Cancel" Height="34" Margin="0,6,0,0"
            Background="Transparent" Foreground="#64748B" CornerRadius="6"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
  </StackPanel>
</Window>
