<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Auth.ChangePasswordWindow"
        Title="Change Password"
        Width="380" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F172A">

  <StackPanel Margin="24" Spacing="10">

    <TextBlock Text="Change Password" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

    <TextBlock Text="Current Password" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="CurrentPasswordBox" Height="36" PasswordChar="●"/>

    <TextBlock Text="New Password" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="NewPasswordBox" Height="36" PasswordChar="●"/>

    <TextBlock Text="Confirm New Password" Foreground="#94A3B8" FontSize="12"/>
    <TextBox x:Name="ConfirmPasswordBox" Height="36" PasswordChar="●"/>

    <TextBlock x:Name="ErrorText" Foreground="#F09595" FontSize="12" IsVisible="False"/>
    <TextBlock x:Name="SuccessText" Text="Password changed successfully." Foreground="#1D9E75" FontSize="12" IsVisible="False"/>

    <Button x:Name="SaveButton" Content="Save" Height="42" Margin="0,10,0,0"
            Background="#1D9E75" Foreground="White" CornerRadius="8"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
  </StackPanel>
</Window>
