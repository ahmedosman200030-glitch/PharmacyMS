<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharmacyMS.Desktop.Views.License.LicenseEntryView">
  <Grid RowDefinitions="48,*" ColumnDefinitions="360,*">

    <!-- Top Red Header Bar -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#991B1B">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
        <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png" Width="26" Height="26"/>
        <TextBlock Text="PharmaPro" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Left Sidebar -->
    <Grid Grid.Row="1" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="220"/>
      </Grid.RowDefinitions>

      <!-- White top section -->
      <Border Grid.Row="0" Background="White" Padding="24,28,24,20">
        <StackPanel Spacing="0">
          <!-- Logo centered -->
          <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
                 Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" Margin="0,0,0,3">
            <TextBlock Text="Pharma" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Pro" FontSize="30" FontWeight="Bold" Foreground="#B91C1C"/>
          </StackPanel>
          <TextBlock Text="Pharmacy Management System" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,3"/>
          <TextBlock Text="Smart Pharmacy. Stronger Business." FontSize="11.5" FontWeight="SemiBold" Foreground="#B91C1C" HorizontalAlignment="Center" Margin="0,0,0,20"/>

          <!-- Feature Cards -->
          <StackPanel Spacing="10">

            <Border Background="#FEF2F2" CornerRadius="12" Padding="14,11">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Background="#FECACA" CornerRadius="24" Width="48" Height="48">
                  <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M12,1 L3,5 L3,11 C3,16.5 7,21.7 12,23 C17,21.7 21,16.5 21,11 L21,5 Z"
                        Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Secure &amp; Trusted" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C"/>
                  <TextBlock Text="Your data is safe and secure with PharmaPro." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#FEF2F2" CornerRadius="12" Padding="14,11">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Background="#FECACA" CornerRadius="24" Width="48" Height="48">
                  <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M21,2 L3,2 C2,2 1,3 1,4 L1,20 C1,21 2,22 3,22 L21,22 C22,22 23,21 23,20 L23,4 C23,3 22,2 21,2 Z M9,17 L5,13 L6.4,11.6 L9,14.2 L17.6,5.6 L19,7 Z"
                        Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Activate Your License" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C"/>
                  <TextBlock Text="Enter your license information to unlock all features." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#FEF2F2" CornerRadius="12" Padding="14,11">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Background="#FECACA" CornerRadius="24" Width="48" Height="48">
                  <Path Fill="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M13,17 L11,17 L11,11 L13,11 Z M13,9 L11,9 L11,7 L13,7 Z"
                        Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Need Help?" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C"/>
                  <TextBlock Text="Contact our support team we're here to help." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Red bottom with white curve -->
      <Grid Grid.Row="1">
        <Border Background="#B91C1C"/>
        <Canvas ClipToBounds="True" Height="220">
          <Path Fill="White" Data="M 0,0 Q 180,80 360,0 L 360,-10 L 0,-10 Z"/>
        </Canvas>
        <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,32" Spacing="10">
          <Grid ColumnDefinitions="*,*,*">
            <TextBlock Grid.Column="0" Text="Pharmacy Info" FontSize="10" Foreground="#FECACA" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="License Setup" FontSize="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Finish" FontSize="10" Foreground="#FECACA" HorizontalAlignment="Center"/>
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
            <Border Background="White" CornerRadius="18" Width="36" Height="36">
              <TextBlock Text="1" FontSize="14" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="White" Height="2" Width="32" VerticalAlignment="Center" Opacity="0.6"/>
            <Border Background="White" CornerRadius="18" Width="36" Height="36">
              <TextBlock Text="2" FontSize="14" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Background="White" Height="2" Width="32" VerticalAlignment="Center" Opacity="0.3"/>
            <Border Background="White" CornerRadius="18" Width="36" Height="36" Opacity="0.35">
              <TextBlock Text="3" FontSize="14" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Right Panel -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
      <Border Padding="44,36,44,36">
        <StackPanel Spacing="24">

          <!-- Header -->
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Background="#FEE2E2" CornerRadius="10" Width="44" Height="44">
                <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png"
                       Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="License Setup" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Enter your license information to activate PharmaPro." FontSize="12" Foreground="#64748B"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="If you don't have a license, contact PharmaPro to purchase one." FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
          </StackPanel>

          <!-- License Information -->
          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
            <StackPanel Spacing="18">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="📄" FontSize="14"/>
                <TextBlock Text="License Information" FontSize="15" FontWeight="SemiBold" Foreground="#B91C1C"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,16,Auto,16,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="License Key" FontSize="13" FontWeight="Medium" Foreground="#374151"/>
                    <TextBlock Text="*" Foreground="#B91C1C" FontWeight="Bold"/>
                  </StackPanel>
                  <TextBox x:Name="LicenseKeyBox" Watermark="PMS-XXXXXXXX-XXXXXXXX" FontSize="13" Padding="12,10"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                  <TextBlock Text="License Type" FontSize="13" FontWeight="Medium" Foreground="#374151"/>
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,11">
                    <TextBlock Text="Professional" FontSize="13" Foreground="#374151" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                  <TextBlock Text="License Duration" FontSize="13" FontWeight="Medium" Foreground="#374151"/>
                  <ComboBox x:Name="DurationBox" HorizontalAlignment="Stretch" Padding="12,10" FontSize="13" IsEnabled="False">
                    <ComboBoxItem Content="Monthly"/>
                    <ComboBoxItem Content="Annual"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                  <TextBlock Text="Number of Users" FontSize="13" FontWeight="Medium" Foreground="#374151"/>
                  <ComboBox x:Name="UsersBox" HorizontalAlignment="Stretch" Padding="12,10" FontSize="13">
                    <ComboBoxItem Content="1 User"/>
                    <ComboBoxItem Content="2 Users"/>
                    <ComboBoxItem Content="3 Users"/>
                    <ComboBoxItem Content="4 Users"/>
                    <ComboBoxItem Content="5 Users"/>
                    <ComboBoxItem Content="6 Users"/>
                    <ComboBoxItem Content="7 Users"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6">
                  <TextBlock Text="Activation Code (Optional)" FontSize="13" FontWeight="Medium" Foreground="#374151"/>
                  <TextBox x:Name="ActivationCodeBox" Watermark="Optional activation code" FontSize="13" Padding="12,10"/>
                  <TextBlock Text="Optional activation code" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- License Details -->
          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
            <StackPanel Spacing="18">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="ℹ" FontSize="14"/>
                <TextBlock Text="License Details" FontSize="15" FontWeight="SemiBold" Foreground="#B91C1C"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,16,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                  <TextBlock Text="Status" FontSize="12" Foreground="#64748B"/>
                  <Border x:Name="StatusBadge" Background="#FEE2E2" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left">
                    <TextBlock x:Name="StatusText" Text="Not Activated" FontSize="12" FontWeight="SemiBold" Foreground="#991B1B"/>
                  </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                  <TextBlock Text="Licensed To" FontSize="12" Foreground="#64748B"/>
                  <TextBlock x:Name="LicensedToText" Text="-" FontSize="13" FontWeight="Medium" Foreground="#0F172A"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                  <TextBlock Text="Activation Date" FontSize="12" Foreground="#64748B"/>
                  <TextBlock x:Name="ActivationDateText" Text="-" FontSize="13" Foreground="#0F172A"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                  <TextBlock Text="Expiry Date" FontSize="12" Foreground="#64748B"/>
                  <TextBlock x:Name="ExpiryDateText" Text="-" FontSize="13" Foreground="#0F172A"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Internet Notice -->
          <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="Make sure you have an active internet connection to validate your license."
                         FontSize="12" Foreground="#92400E" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>

          <Grid ColumnDefinitions="*,16,*">
            <Button Grid.Column="0" Content="← Back" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,13"
                    Background="White" Foreground="#374151"
                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                    FontSize="13" Click="OnBackClick"/>
            <Button Grid.Column="2" x:Name="ActivateButton" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="0,13"
                    Background="#B91C1C" Foreground="White" CornerRadius="8" Click="OnActivateClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🔒" FontSize="13"/>
                <TextBlock x:Name="ActivateText" Text="Activate License" FontSize="13" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
          </Grid>

        </StackPanel>
      </Border>
    </ScrollViewer>

  </Grid>
</UserControl>
