using Avalonia.Controls;
using Avalonia.Interactivity;
using Avalonia.Markup.Xaml;
using Avalonia.Media;
using Microsoft.Extensions.DependencyInjection;
using PharmacyMS.Application.Interfaces.Services;
using PharmacyMS.Desktop.Services;

namespace PharmacyMS.Desktop.Views.License;

public partial class LicenseEntryView : UserControl
{
    private readonly IAppSettingsService? _settingsService;
    private readonly Action _onActivated;
    private readonly Action? _onBack;

    private TextBox _licenseKeyBox = null!;
    private TextBlock _errorText = null!;
    private TextBlock _statusText = null!;
    private Border _statusBadge = null!;
    private TextBlock _expiryDateText = null!;
    private TextBlock _licensedToText = null!;
    private TextBlock _activationDateText = null!;
    private TextBlock _activateText = null!;
    private Button _activateButton = null!;
    private ComboBox _durationBox = null!;
    private ComboBox _usersBox = null!;

    public LicenseEntryView(Action onActivated, Action? onBack = null)
    {
        AvaloniaXamlLoader.Load(this);
        _onActivated = onActivated;
        _onBack = onBack;
        _settingsService = Program.Services?.GetService<IAppSettingsService>();

        _licenseKeyBox    = this.FindControl<TextBox>("LicenseKeyBox")!;
        _errorText        = this.FindControl<TextBlock>("ErrorText")!;
        _statusText       = this.FindControl<TextBlock>("StatusText")!;
        _statusBadge      = this.FindControl<Border>("StatusBadge")!;
        _expiryDateText   = this.FindControl<TextBlock>("ExpiryDateText")!;
        _licensedToText   = this.FindControl<TextBlock>("LicensedToText")!;
        _activationDateText = this.FindControl<TextBlock>("ActivationDateText")!;
        _activateText     = this.FindControl<TextBlock>("ActivateText")!;
        _activateButton   = this.FindControl<Button>("ActivateButton")!;
        _durationBox      = this.FindControl<ComboBox>("DurationBox")!;
        _usersBox         = this.FindControl<ComboBox>("UsersBox")!;

        _durationBox.SelectedIndex = 1; // Annual default
        _usersBox.SelectedIndex = 0;    // 1 User default

        _ = LoadPharmacyNameAsync();
    }

    private async Task LoadPharmacyNameAsync()
    {
        if (_settingsService == null) return;
        try
        {
            var name = await _settingsService.GetPharmacyNameAsync();
            if (!string.IsNullOrWhiteSpace(name))
                _licensedToText.Text = name;
        }
        catch { }
    }

    private void OnBackClick(object? sender, RoutedEventArgs e)
    {
        _onBack?.Invoke();
    }

    private async void OnActivateClick(object? sender, RoutedEventArgs e)
    {
        _errorText.IsVisible = false;
        var key = _licenseKeyBox.Text ?? "";
        var result = LicenseService.Validate(key);

        if (!result.IsValid)
        {
            _errorText.Text = result.ErrorMessage ?? "Invalid license.";
            _errorText.IsVisible = true;
            SetStatus("Not Activated", false);
            return;
        }

        // Show activated state in details
        SetStatus("Active", true);
        _expiryDateText.Text = result.ExpiryDate.HasValue
            ? result.ExpiryDate.Value.ToString("dd MMM yyyy")
            : "-";
        _activationDateText.Text = DateTime.Now.ToString("dd MMM yyyy");

        _activateButton.IsEnabled = false;
        _activateText.Text = "Activating...";

        if (_settingsService != null)
            await _settingsService.SetLicenseKeyAsync(key.Trim());

        _onActivated();
    }

    private void SetStatus(string text, bool active)
    {
        _statusText.Text = text;
        if (active)
        {
            _statusBadge.Background = new SolidColorBrush(Color.Parse("#DCFCE7"));
            _statusText.Foreground = new SolidColorBrush(Color.Parse("#166534"));
        }
        else
        {
            _statusBadge.Background = new SolidColorBrush(Color.Parse("#FEE2E2"));
            _statusText.Foreground = new SolidColorBrush(Color.Parse("#991B1B"));
        }
    }
}
