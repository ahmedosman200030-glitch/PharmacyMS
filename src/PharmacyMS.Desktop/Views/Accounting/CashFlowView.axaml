<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PharmacyMS.Desktop.Controls"
             x:Class="PharmacyMS.Desktop.Views.Accounting.CashFlowView"
             x:DataType="vm:CashFlowViewModel"
             Background="#F1F5F9">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFCFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 1 6 0 #14000000"/>
    </Style>
    <Style Selector="Border.stat-icon">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
    <Style Selector="TextBlock.stat-value">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
  <StackPanel Margin="24" Spacing="16">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Cash Flow" Classes="stat-value" Foreground="#0F172A"/>
        <TextBlock Text="Track money moving in and out of your business" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:DateRangePicker x:Name="RangePicker"/>
        <Button x:Name="RefreshButton" Content="🔄 Refresh" Background="#2563EB" Foreground="White" CornerRadius="8" Padding="12,6" FontSize="13"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Classes="card" Background="#EFF6FF" ClipToBounds="True" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#ECFDF5" HorizontalAlignment="Center">
            <TextBlock Text="📊" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="CASH IN" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CashInText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock Text="This Period" FontSize="11" Foreground="#10B981" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Background="#F0FDF4" ClipToBounds="True" BorderBrush="#BBF7D0" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#FEF2F2" HorizontalAlignment="Center">
            <TextBlock Text="📊" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="CASH OUT" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CashOutText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock Text="This Period" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Background="#FFFBEB" ClipToBounds="True" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="14" Background="#2563EB" HorizontalAlignment="Center">
            <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="NET CASH FLOW" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="NetCashFlowText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock Text="This Period" FontSize="11" Foreground="#3B82F6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="card" Background="#FAF5FF" ClipToBounds="True" BorderBrush="#E9D5FF" BorderThickness="1.2" CornerRadius="16" Padding="16">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#F5F3FF" HorizontalAlignment="Center">
            <TextBlock Text="$" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="CASH BALANCE" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CashBalanceText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock Text="All Time" FontSize="11" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
          <TextBlock Text="Cash In vs Cash Out" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="✓" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="Cash In" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="✓" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="Cash Out" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <Canvas x:Name="TrendCanvas" Height="220"/>
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AllFilterBtn" Content="All Transactions" Padding="12,6" CornerRadius="8" FontSize="13"/>
          <Button x:Name="InFilterBtn" Content="Cash In" Padding="12,6" CornerRadius="8" FontSize="13"/>
          <Button x:Name="OutFilterBtn" Content="Cash Out" Padding="12,6" CornerRadius="8" FontSize="13"/>
        </StackPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" Watermark="Search transactions..."/>
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="16">
      <StackPanel Spacing="10">
        <DataGrid x:Name="RowsGrid" MaxHeight="320" VerticalScrollBarVisibility="Auto" HeadersVisibility="Column"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
            <DataGridTemplateColumn Header="Direction" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding Direction, Converter={x:Static vm:DirectionColorConverter.Instance}}"
                          CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Direction}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120"/>
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=$\{0:F2\}}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="PagingSummaryText" Text="" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PrevPageBtn" Content="‹ Prev" Padding="10,4"/>
            <TextBlock x:Name="PageLabelText" Text="Page 1 of 1" VerticalAlignment="Center" Foreground="#334155"/>
            <Button x:Name="NextPageBtn" Content="Next ›" Padding="10,4"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

  </StackPanel>
  </ScrollViewer>
</UserControl>
