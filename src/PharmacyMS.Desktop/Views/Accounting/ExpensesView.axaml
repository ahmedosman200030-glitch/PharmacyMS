<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PharmacyMS.Desktop.Controls"
             x:Class="PharmacyMS.Desktop.Views.Accounting.ExpensesView"
             x:DataType="vm:ExpensesViewModel"
             Background="#F1F5F9">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 1 6 0 #14000000"/>
    </Style>
    <Style Selector="Border.stat-icon">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
    <Style Selector="TextBlock.stat-value">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
  <StackPanel Margin="24" Spacing="16">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Expenses" Classes="stat-value" Foreground="#0F172A"/>
        <TextBlock Text="Track and manage business expenses" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:DateRangePicker x:Name="RangePicker"/>
        <Button x:Name="RefreshButton" Content="🔄 Refresh" Background="#2563EB" Foreground="White" CornerRadius="8" Padding="12,6" FontSize="13"/>
        <Button x:Name="AddExpenseBtn" Content="+ Add Expense" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="12,6" FontSize="13"/>
      </StackPanel>
    </Grid>

    <!-- Stat cards -->
    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#FEF2F2" HorizontalAlignment="Center">
            <Path Data="M12 20 L12 4 M12 20 L6 14 M12 20 L18 14" Stroke="#DC2626" StrokeThickness="2.2"
                  StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="TOTAL EXPENSES" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TotalExpensesText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TotalExpensesPeriodText" Text="" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#F5F3FF" HorizontalAlignment="Center">
            <Path Data="M4 6 L16 6 M4 10 L16 10 M4 14 L12 14" Stroke="#8B5CF6" StrokeThickness="2"
                  StrokeLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="TRANSACTIONS" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TxnCountText" Text="0" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TxnCountPeriodText" Text="" FontSize="11" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#FFF7ED" HorizontalAlignment="Center">
            <Ellipse Width="20" Height="20" Stroke="#F59E0B" StrokeThickness="2"/>
          </Border>
          <TextBlock Text="AVG. EXPENSE" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AvgExpenseText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AvgExpensePeriodText" Text="" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="card" Padding="16">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#EFF6FF" HorizontalAlignment="Center">
            <Path Data="M4 4 L16 4 L16 16 L4 16 Z M4 10 L16 10 M10 4 L10 16" Stroke="#3B82F6" StrokeThickness="1.8"
                  StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="CATEGORIES" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CategoryCountText" Text="0" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CategoryCountPeriodText" Text="" FontSize="11" Foreground="#3B82F6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Filter + search -->
    <Border Classes="card" Padding="12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="#334155" FontSize="13" Margin="0,0,4,0"/>
          <ComboBox x:Name="CategoryFilterCombo" Width="180"/>
        </StackPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" Watermark="Search expenses..."/>
      </DockPanel>
    </Border>

    <!-- Table -->
    <Border Classes="card" Padding="16">
      <StackPanel Spacing="10">
        <DataGrid x:Name="ExpenseGrid" HeadersVisibility="Column"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="110"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=$\{0:F2\}}" Width="100"/>
            <DataGridTextColumn Header="Added By" Binding="{Binding CreatedBy}" Width="120"/>
            <DataGridTemplateColumn Header="" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Delete" Name="DeleteBtn" FontSize="11" Padding="8,3"
                          Background="#FEF2F2" Foreground="#DC2626" CornerRadius="4"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="PagingSummaryText" Text="" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PrevPageBtn" Content="‹ Prev" Padding="10,4"/>
            <TextBlock x:Name="PageLabelText" Text="Page 1 of 1" VerticalAlignment="Center" Foreground="#334155"/>
            <Button x:Name="NextPageBtn" Content="Next ›" Padding="10,4"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Charts row -->
    <Grid ColumnDefinitions="*,*,*">
      <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Spending by Category" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
          <Canvas x:Name="DonutCanvas" Height="160"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Expense Trend" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
          <Canvas x:Name="TrendCanvas" Height="160"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Top Categories" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
          <StackPanel x:Name="TopCategoriesPanel" Spacing="8"/>
        </StackPanel>
      </Border>
    </Grid>

  </StackPanel>
  </ScrollViewer>
</UserControl>
