<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PharmacyMS.Desktop.Controls"
             xmlns:ent="clr-namespace:PharmacyMS.Domain.Entities;assembly=PharmacyMS.Domain"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="PharmacyMS.Desktop.Views.Accounting.AccountingView"
             x:DataType="vm:AccountingViewModel"
             Background="#F1F5F9">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFCFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 1 6 0 #14000000"/>
    </Style>
    <Style Selector="Border.stat-icon">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
    <Style Selector="TextBlock.stat-value">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
  <StackPanel Margin="24" Spacing="16">

    <!-- Header -->
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Accounting Overview" Classes="stat-value" FontSize="24" Foreground="#0F172A" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <controls:DateRangePicker x:Name="RangePicker"/>
        <Button x:Name="RefreshButton" Background="#DC2626" Foreground="White" CornerRadius="6" Padding="14,6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" Foreground="White"/>
            <TextBlock Text="Refresh" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Stat cards row 1 -->
    <Grid ColumnDefinitions="*,*,*,*,*">
      <Border Grid.Column="0" Classes="card" Background="#EFF6FF" ClipToBounds="True" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#DBEAFE" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="CashMultiple" Width="22" Height="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="TOTAL REVENUE" Classes="stat-label"/>
            <TextBlock x:Name="RevenueText" Text="$0.00" Classes="stat-value" Foreground="#2563EB"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card" Background="#FFF7ED" ClipToBounds="True" BorderBrush="#FED7AA" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#FFEDD5" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="CartOutline" Width="22" Height="22" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="TOTAL PURCHASES" Classes="stat-label"/>
            <TextBlock x:Name="PurchasesText" Text="$0.00" Classes="stat-value" Foreground="#EA580C"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Classes="card" Background="#ECFDF5" ClipToBounds="True" BorderBrush="#A7F3D0" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#D1FAE5" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="TrendingUp" Width="22" Height="22" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="GROSS PROFIT" Classes="stat-label"/>
            <TextBlock x:Name="GrossProfitText" Text="$0.00" Classes="stat-value" Foreground="#059669"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="3" Classes="card" Background="#FEF2F2" ClipToBounds="True" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#FEE2E2" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="CashMinus" Width="22" Height="22" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="TOTAL EXPENSES" Classes="stat-label"/>
            <TextBlock x:Name="ExpensesText" Text="$0.00" Classes="stat-value" Foreground="#DC2626"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="4" Classes="card" Background="#FEFCE8" ClipToBounds="True" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="16" Padding="16">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#FEF9C3" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="TrophyOutline" Width="22" Height="22" Foreground="#CA8A04" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="NET PROFIT" Classes="stat-label"/>
            <TextBlock x:Name="NetProfitText" Text="$0.00" Classes="stat-value" Foreground="#CA8A04"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Stat cards row 2 -->
    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Classes="card" Background="#ECFEFF" ClipToBounds="True" BorderBrush="#A5F3FC" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#CFFAFE" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="Wallet" Width="22" Height="22" Foreground="#0891B2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="CASH BALANCE" Classes="stat-label"/>
            <TextBlock x:Name="CashBalanceText" Text="$0.00" Classes="stat-value" Foreground="#0891B2"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card" Background="#F5F3FF" ClipToBounds="True" BorderBrush="#DDD6FE" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#EDE9FE" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="CUSTOMER CREDIT" Classes="stat-label"/>
            <TextBlock x:Name="CustomerCreditText" Text="$0.00" Classes="stat-value" Foreground="#7C3AED"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Classes="card" Background="#FFFBEB" ClipToBounds="True" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#FEF3C7" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="OfficeBuilding" Width="22" Height="22" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="SUPPLIER PAYABLES" Classes="stat-label"/>
            <TextBlock x:Name="SupplierPayablesText" Text="$0.00" Classes="stat-value" Foreground="#D97706"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="3" Classes="card" Background="#F0FDFA" ClipToBounds="True" BorderBrush="#99F6E4" BorderThickness="1.2" CornerRadius="16" Padding="16">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="stat-icon" Background="#CCFBF1" VerticalAlignment="Top">
            <mi:MaterialIcon Kind="PackageVariantClosed" Width="22" Height="22" Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0" Spacing="6">
            <TextBlock Text="STOCK VALUE" Classes="stat-label"/>
            <TextBlock x:Name="StockValueText" Text="$0.00" Classes="stat-value" Foreground="#0D9488"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Chart + Recent Transactions -->
    <Grid ColumnDefinitions="*,380">
      <Border Grid.Column="0" Classes="card" Background="#FFFFFF" ClipToBounds="True" BorderBrush="#E5E7EB" BorderThickness="1.2" CornerRadius="16" Padding="20" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Income vs Expenses vs Profit" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16"/>
          <Canvas x:Name="ChartCanvas" Height="220"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Background="#FFFFFF" ClipToBounds="True" BorderBrush="#E5E7EB" BorderThickness="1.2" CornerRadius="16" Padding="20">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Recent Transactions" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
          <DataGrid x:Name="TxnGrid" MaxHeight="320" VerticalScrollBarVisibility="Auto" HeadersVisibility="All"
                    x:DataType="vm:AccountingTransaction" AutoGenerateColumns="False"
                    IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
              <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=$\{0:F2\}}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Quick Actions -->
    <Border Classes="card" Padding="20">
      <StackPanel Spacing="12">
        <TextBlock Text="Quick Actions" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ExportBtn" Background="#DC2626" Foreground="White" CornerRadius="8" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Printer" Width="16" Height="16" Foreground="White"/>
              <TextBlock Text="Export Report" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
  </ScrollViewer>
</UserControl>
