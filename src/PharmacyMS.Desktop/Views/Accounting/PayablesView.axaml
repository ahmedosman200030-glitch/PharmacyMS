<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PharmacyMS.Desktop.Controls"
             x:Class="PharmacyMS.Desktop.Views.Accounting.PayablesView"
             x:DataType="vm:PayablesViewModel"
             Background="#F1F5F9">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFCFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 1 6 0 #14000000"/>
    </Style>
    <Style Selector="Border.stat-icon">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
    <Style Selector="TextBlock.stat-value">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
  <StackPanel Margin="24" Spacing="16">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Payables (Suppliers)" Classes="stat-value" Foreground="#0F172A"/>
        <TextBlock Text="Track supplier dues and payments" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:DateRangePicker x:Name="RangePicker"/>
        <Button x:Name="RefreshButton" Content="🔄 Refresh" Background="#2563EB" Foreground="White" CornerRadius="8" Padding="12,6" FontSize="13"/>
        <Button x:Name="AddPaymentBtn" Content="+ Make Payment" Background="#2563EB" Foreground="White" CornerRadius="8" Padding="12,6" FontSize="13"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Classes="card" Background="#EFF6FF" ClipToBounds="True" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#F5F3FF" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="TOTAL PAYABLES" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TotalPayablesText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TotalPayablesSubText" Text="" FontSize="11" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Background="#F0FDF4" ClipToBounds="True" BorderBrush="#BBF7D0" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#ECFDF5" HorizontalAlignment="Center">
            <TextBlock Text="📊" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="TOTAL PAID" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TotalPaidText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock Text="This Month" FontSize="11" Foreground="#10B981" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Background="#FFFBEB" ClipToBounds="True" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="14" Background="#D97706" HorizontalAlignment="Center">
            <TextBlock Text="📊" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="OUTSTANDING AMOUNT" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="OutstandingText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="OutstandingSubText" Text="" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="card" Background="#FAF5FF" ClipToBounds="True" BorderBrush="#E9D5FF" BorderThickness="1.2" CornerRadius="16" Padding="16">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="14" Background="#2563EB" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="AGING 90+ DAYS" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AgingOver90Text" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock Text="Needs attention" FontSize="11" Foreground="#3B82F6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card" Padding="12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AllFilterBtn" Content="All Suppliers" Padding="12,6" CornerRadius="8" FontSize="13"/>
          <Button x:Name="OutstandingFilterBtn" Content="Outstanding" Padding="12,6" CornerRadius="8" FontSize="13"/>
          <Button x:Name="PaidFilterBtn" Content="Paid" Padding="12,6" CornerRadius="8" FontSize="13"/>
        </StackPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" Watermark="Search supplier..."/>
      </DockPanel>
    </Border>

    <Border Classes="card" Padding="16">
      <StackPanel Spacing="10">
        <DataGrid x:Name="RowsGrid" MaxHeight="320" VerticalScrollBarVisibility="Auto" HeadersVisibility="Column"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Supplier" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{Binding AvatarColor}">
                      <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding SupplierName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
            <DataGridTextColumn Header="Total Purchases" Binding="{Binding TotalPurchases, StringFormat=$\{0:F2\}}" Width="110"/>
            <DataGridTextColumn Header="Total Paid" Binding="{Binding TotalPaid, StringFormat=$\{0:F2\}}" Width="110"/>
            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=$\{0:F2\}}" Width="110"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            <DataGridTextColumn Header="Last Payment" Binding="{Binding LastPayment, StringFormat=\{0:yyyy-MM-dd\}}" Width="110"/>
            <DataGridTemplateColumn Header="" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Pay" Name="PayBtn" FontSize="11" Padding="10,3"
                          Background="#EFF6FF" Foreground="#3B82F6" CornerRadius="4"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="PagingSummaryText" Text="" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PrevPageBtn" Content="‹ Prev" Padding="10,4"/>
            <TextBlock x:Name="PageLabelText" Text="Page 1 of 1" VerticalAlignment="Center" Foreground="#334155"/>
            <Button x:Name="NextPageBtn" Content="Next ›" Padding="10,4"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,*,*">
      <Border Grid.Column="0" Classes="card" Background="#EFF6FF" ClipToBounds="True" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Aging Summary" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
          <Canvas x:Name="DonutCanvas" Height="160"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Background="#F0FDF4" ClipToBounds="True" BorderBrush="#BBF7D0" BorderThickness="1.2" CornerRadius="16" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Receivables Trend" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
          <Canvas x:Name="TrendCanvas" Height="160"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Background="#FFFBEB" ClipToBounds="True" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="16" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Top Suppliers (Outstanding)" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
          <StackPanel x:Name="TopListPanel" Spacing="8"/>
        </StackPanel>
      </Border>
    </Grid>

  </StackPanel>
  </ScrollViewer>
</UserControl>
