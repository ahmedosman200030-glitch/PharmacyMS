<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharmacyMS.Desktop.Views.Accounting.ExpenseFormWindow"
        Title="Add Expense"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F1F5F9">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="Add Expense" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>

    <StackPanel Spacing="4">
      <TextBlock Text="Date" FontSize="12" Foreground="#64748B"/>
      <DatePicker x:Name="DatePickerBox" HorizontalAlignment="Stretch"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Category" FontSize="12" Foreground="#64748B"/>
      <ComboBox x:Name="CategoryCombo" HorizontalAlignment="Stretch"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Description" FontSize="12" Foreground="#64748B"/>
      <TextBox x:Name="DescriptionBox" Watermark="e.g. August electricity bill"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Amount" FontSize="12" Foreground="#64748B"/>
      <TextBox x:Name="AmountBox" Watermark="0.00"/>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Padding="16,8" CornerRadius="6"/>
      <Button x:Name="SaveButton" Content="Save Expense" Padding="16,8" CornerRadius="6"
              Background="#DC2626" Foreground="White"/>
    </StackPanel>
  </StackPanel>
</Window>
