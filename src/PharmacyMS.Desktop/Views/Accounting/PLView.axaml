<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PharmacyMS.Desktop.Controls"
             x:Class="PharmacyMS.Desktop.Views.Accounting.PLView"
             x:DataType="vm:PLViewModel"
             Background="#F1F5F9">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 1 6 0 #14000000"/>
    </Style>
    <Style Selector="Border.stat-icon">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#6B7280"/>
    </Style>
    <Style Selector="TextBlock.stat-value">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
  <StackPanel Margin="24" Spacing="16">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Profit &amp; Loss" Classes="stat-value" Foreground="#0F172A"/>
        <TextBlock Text="View your business profit and loss summary" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:DateRangePicker x:Name="RangePicker"/>
        <Button x:Name="RefreshButton" Content="🔄 Refresh" Background="#2563EB" Foreground="White" CornerRadius="8" Padding="12,6" FontSize="13"/>
        <Button x:Name="ExportButton" Content="⬇ Export" Padding="12,6" CornerRadius="8" FontSize="13"/>
        <Button x:Name="PrintButton" Content="🖨 Print" Padding="12,6" CornerRadius="8" FontSize="13"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,*,*,*,*">
      <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#EFF6FF" HorizontalAlignment="Center">
            <TextBlock Text="$" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="TOTAL REVENUE" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="RevenueText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="RevenueChangeText" Text="" FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#ECFDF5" HorizontalAlignment="Center">
            <TextBlock Text="🛒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="COST OF GOODS SOLD" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CogsText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="CogsChangeText" Text="" FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#FFF7ED" HorizontalAlignment="Center">
            <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="GROSS PROFIT" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="GrossProfitText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="GrossProfitChangeText" Text="" FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="card" Margin="0,0,10,0">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#F5F3FF" HorizontalAlignment="Center">
            <TextBlock Text="👛" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="TOTAL EXPENSES" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="ExpensesText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="ExpensesChangeText" Text="" FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Classes="card" Padding="16">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Classes="stat-icon" Background="#ECFDF5" HorizontalAlignment="Center">
            <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="NET PROFIT" Classes="stat-label" HorizontalAlignment="Center"/>
          <TextBlock x:Name="NetProfitText" Text="$0.00" Classes="stat-value" HorizontalAlignment="Center"/>
          <TextBlock x:Name="NetProfitChangeText" Text="" FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="1.6*,*">
      <Border Grid.Column="0" Classes="card" Padding="20" Margin="0,0,12,0">
        <StackPanel Spacing="10">
          <TextBlock Text="Profit &amp; Loss Statement" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Description" Classes="stat-label"/>
            <TextBlock Grid.Column="1" Text="This Period" Classes="stat-label" Width="110" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="% of Revenue" Classes="stat-label" Width="110" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel x:Name="StatementPanel" Spacing="4"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Spacing="16">
        <Border Classes="card" Padding="16">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Profit Overview (This Period)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
            <StackPanel DockPanel.Dock="Bottom" x:Name="DonutLegendPanel" Spacing="6" Margin="0,10,0,0"/>
            <Canvas x:Name="DonutCanvas" Height="160"/>
          </DockPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Net Profit Trend" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10"/>
            <Canvas x:Name="TrendCanvas" Height="150"/>
          </DockPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Key Ratios (This Period)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,10">
                <TextBlock Text="Gross Profit Margin" FontSize="11" Foreground="#64748B"/>
                <TextBlock x:Name="GpMarginText" Text="0.00%" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,10">
                <TextBlock Text="Expense to Revenue" FontSize="11" Foreground="#64748B"/>
                <TextBlock x:Name="ExpRatioText" Text="0.00%" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                <TextBlock Text="Net Profit Margin" FontSize="11" Foreground="#64748B"/>
                <TextBlock x:Name="NpMarginText" Text="0.00%" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <TextBlock Text="Cost to Revenue" FontSize="11" Foreground="#64748B"/>
                <TextBlock x:Name="CostRatioText" Text="0.00%" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border Background="#EFF6FF" CornerRadius="10" Padding="14">
      <TextBlock Text="Profit &amp; Loss shows your financial performance for the selected period. All values are based on confirmed transactions." FontSize="12" Foreground="#3B82F6" TextWrapping="Wrap"/>
    </Border>

  </StackPanel>
  </ScrollViewer>
</UserControl>
