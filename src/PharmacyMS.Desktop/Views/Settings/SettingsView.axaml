<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
        x:Class="PharmacyMS.Desktop.Views.Settings.SettingsView"
        x:DataType="vm:SettingsViewModel"
        Background="#F1F5F9">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Text="Manage your pharmacy system preferences and configurations" FontSize="12" Foreground="#64748B"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
        <TextBlock x:Name="SuccessText" Text="Saved." Foreground="#DC2626" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
        <Button x:Name="SaveButton" Content="Save Settings" Height="40" Padding="18,0"
                Background="#DC2626" Foreground="White" CornerRadius="8" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>

    <!-- Body: sidebar + content -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10"
              BoxShadow="0 1 4 0 #22000000" Margin="0,0,16,0" VerticalAlignment="Top">
        <StackPanel Spacing="4">

          <Button x:Name="NavGeneral" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⚙" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="General" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="App name, logo, currency" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavPharmacy" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🏥" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Pharmacy Information" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Name, contact, address" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavTax" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🧾" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Tax &amp; Invoicing" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="VAT, invoice prefix, footer" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavSecurity" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🔒" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Security" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Change your password" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavDatabase" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="DB" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Database" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Backup &amp; restore" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavCloudSync" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="☁" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Database Mode" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Offline, Local Network, or Cloud" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavEmail" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Email" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="SMTP settings for recovery codes" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavSounds" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🔊" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="Sound Effects" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Notifications &amp; volume" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="NavAbout" Classes="navitem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="ℹ" FontSize="16"/>
              <StackPanel Spacing="1">
                <TextBlock Text="About" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Version info" FontSize="10.5" Foreground="#94A3B8"/>
              </StackPanel>
            </StackPanel>
          </Button>

        </StackPanel>
      </Border>

      <!-- Content -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="18" MaxWidth="800" HorizontalAlignment="Left">

          <!-- General -->
          <Border x:Name="PanelGeneral" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="General" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>

              <Grid ColumnDefinitions="220,*" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="10">
                  <TextBlock Text="App Logo" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                  <Border Width="200" Height="140" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <Image x:Name="LogoPreview" Stretch="Uniform" Margin="10"/>
                  </Border>
                  <Button x:Name="UploadLogoButton" Content="Upload Logo" Height="34"
                          Background="#3B82F6" Foreground="White" CornerRadius="6" Padding="14,4" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                  <TextBlock Text="App Details" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                      <TextBlock Text="App Name" FontSize="12" Foreground="#64748B"/>
                      <TextBox x:Name="AppNameBox" Height="38"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                      <TextBlock Text="Currency Symbol" FontSize="12" Foreground="#64748B"/>
                      <TextBox x:Name="CurrencySymbolBox" Height="38"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                      <TextBlock Text="Language" FontSize="12" Foreground="#64748B"/>
                      <ComboBox x:Name="LanguageCombo" Height="38" HorizontalAlignment="Stretch"/>
                      <TextBlock Text="Applies to receipts now; more screens coming." FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Pharmacy Info -->
          <Border x:Name="PanelPharmacy" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="True">
            <StackPanel Spacing="18">
              <StackPanel Spacing="2">
                <TextBlock Text="Pharmacy Information" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="This appears on the header and footer of your PDF/Excel reports." FontSize="11" Foreground="#94A3B8"/>
              </StackPanel>

              <StackPanel Spacing="12">
                <TextBlock Text="Pharmacy Details" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Pharmacy Name" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="PharmacyNameBox" Height="38"/>
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Website" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="WebsiteBox" Height="38"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                    <TextBlock Text="Tagline" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="TaglineBox" Height="38" Watermark="e.g. Your Health, Our Priority"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Address" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="AddressBox" Height="38"/>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Separator Background="#F1F5F9"/>

              <StackPanel Spacing="12">
                <TextBlock Text="Contact Information" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                    <TextBlock Text="ZAAD Merchant Number" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="PhoneNumberBox" Height="38" Watermark="e.g. 6XXXXXXXX"/>
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                    <TextBlock Text="e-Dahab Merchant Number" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="MobileNumberBox" Height="38" Watermark="e.g. 6XXXXXXXX"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Email Address" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="EmailBox" Height="38"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Contact Number" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="ContactNumberBox" Height="38" Watermark="e.g. 063XXXXXXX"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Tax & Invoicing -->
          <Border x:Name="PanelTax" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="Tax &amp; Invoicing" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Tax / VAT Rate (%)" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="TaxRateBox" Height="38"/>
                  <TextBlock Text="Enter as a percentage, e.g. 15 for 15%." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                  <TextBlock Text="Invoice Number Prefix" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="InvoicePrefixBox" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Default Reorder Level" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="ReorderLevelBox" Height="38"/>
                  <TextBlock Text="Used as the default when adding a new medicine." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBlock Text="Receipt Footer" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="ReceiptFooterBox" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                  <TextBlock Text="SLSH Exchange Rate" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="SlshRateBox" Height="38" Watermark="e.g. 8500"/>
                  <TextBlock Text="Shillings per $1 — shown on receipts under the total." FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Security -->
          <Border x:Name="PanelSecurity" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="Security" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
              <Border Background="#F8FAFC" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                  <TextBlock Text="Update your own login password." FontSize="12" Foreground="#64748B"/>
                  <Button x:Name="ChangePasswordButton" Content="Change Password" Height="38" Width="200"
                          Background="#0F2A43" Foreground="White" CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>

          <!-- Recovery Options -->
          <Border x:Name="PanelRecovery" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000">
            <StackPanel Spacing="16">
              <TextBlock Text="Recovery Options" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
              <Border Background="#F8FAFC" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Recovery Code" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                  <TextBlock Text="Generate a one-time recovery code to regain access if you forget your password. Save it somewhere safe — it will only be shown once." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                  <Button x:Name="GenerateRecoveryCodeButton" Content="Generate Recovery Code" Height="38" Width="220"
                          Background="#0F2A43" Foreground="White" CornerRadius="6" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
            </StackPanel>
          </Border>

          <!-- Database -->
          <Border x:Name="PanelDatabase" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="Database" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>

              <Border Background="#F8FAFC" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Location" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" x:Name="DbPathText" Text="" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Size" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" x:Name="DbSizeText" Text="" FontSize="12" Foreground="#334155"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Last Modified" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" x:Name="DbModifiedText" Text="" FontSize="12" Foreground="#334155"/>
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="BackupButton" Content="Backup Now" Height="38"
                        Background="#DC2626" Foreground="White" CornerRadius="6" Padding="16,4"/>
                <Button x:Name="RestoreButton" Content="Restore From File" Height="38"
                        Background="#F59E0B" Foreground="White" CornerRadius="6" Padding="16,4"/>
              </StackPanel>
              <TextBlock x:Name="DbStatusText" FontSize="12" Foreground="#DC2626" IsVisible="False" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Cloud Sync -->
          <Border x:Name="PanelCloudSync" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="Database Mode" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
              <TextBlock Text="Choose how this PC connects to your pharmacy data: stay fully offline, share data with other PCs over your local network, or sync to the cloud." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>

              <StackPanel Spacing="6">
                <TextBlock Text="Mode" FontSize="12" Foreground="#64748B"/>
                <ComboBox x:Name="DbModeCombo" Height="38" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="DbModeHintText" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
              </StackPanel>

              <Grid x:Name="PostgresFieldsGrid" ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Host" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="CloudHostBox" Height="38" Watermark="aws-0-&lt;region&gt;.pooler.supabase.com (NOT db.xxxx.supabase.co)"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                  <TextBlock Text="Port" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="CloudPortBox" Height="38" Text="5432"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Database" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="CloudDatabaseBox" Height="38" Text="pharmacyms"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBlock Text="Username" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="CloudUsernameBox" Height="38" Watermark="postgres.&lt;project-ref&gt;"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                  <TextBlock Text="Password" FontSize="12" Foreground="#64748B"/>
                  <TextBox x:Name="CloudPasswordBox" Height="38" PasswordChar="•"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                  <TextBlock Text="SSL Mode" FontSize="12" Foreground="#64748B"/>
                  <ComboBox x:Name="CloudSslModeCombo" Height="38" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="TestCloudConnectionButton" Content="Test Connection" Height="38"
                        Background="#3B82F6" Foreground="White" CornerRadius="6" Padding="16,4"/>
                <Button x:Name="SaveCloudSyncButton" Content="Save &amp; Restart" Height="38"
                        Background="#DC2626" Foreground="White" CornerRadius="6" Padding="16,4"/>
                <Button x:Name="MigrateToCloudButton" Content="Migrate Local Data to Cloud" Height="38"
                        Background="#16A34A" Foreground="White" CornerRadius="6" Padding="16,4"/>
              </StackPanel>
              <TextBlock x:Name="CloudSyncStatusText" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Email / Resend -->
          <Border x:Name="PanelEmail" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="Email" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
              <TextBlock Text="Enter your Resend API key to enable emailing recovery codes. Get one free at resend.com." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>

              <StackPanel Spacing="6">
                <TextBlock Text="Resend API Key" FontSize="12" Foreground="#64748B"/>
                <TextBox x:Name="ResendApiKeyBox" Height="38" Watermark="re_..." PasswordChar="•"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="SmtpTestEmailBox" Width="220" Height="38" Watermark="send test to..."/>
                <Button x:Name="TestEmailButton" Content="Send Test Email" Height="38"
                        Background="#3B82F6" Foreground="White" CornerRadius="6" Padding="16,4"/>
                <Button x:Name="SaveEmailButton" Content="Save Email Settings" Height="38"
                        Background="#DC2626" Foreground="White" CornerRadius="6" Padding="16,4"/>
              </StackPanel>
              <TextBlock x:Name="EmailStatusText" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Sound Effects -->
          <Border x:Name="PanelSounds" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="16">
              <TextBlock Text="Sound Effects" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>

              <CheckBox x:Name="EnableSystemSoundsCheck" Content="Enable System Sounds" FontSize="13"/>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="8">
                  <TextBlock Text="Sounds to Play" FontSize="12" Foreground="#64748B"/>
                  <Button x:Name="SoundChecklistToggle" HorizontalContentAlignment="Stretch" Height="38"
                          Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="SoundChecklistSummaryText" Grid.Column="0"
                                 Text="5 of 5 sounds enabled" FontSize="13" Foreground="#334155"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="▾" FontSize="12" Foreground="#94A3B8"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Button>

                  <Popup x:Name="SoundChecklistPopup" PlacementTarget="{Binding #SoundChecklistToggle}"
                         Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True" Width="320">
                    <Border Background="White" CornerRadius="8" Padding="12" BoxShadow="0 4 16 0 #33000000"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <CheckBox x:Name="TransactionSuccessCheck" Content="Transaction Success Sound" FontSize="13"/>
                        <CheckBox x:Name="ErrorSoundCheck" Content="Error Notification Sound" FontSize="13"/>
                        <CheckBox x:Name="WarningSoundCheck" Content="Warning Notification Sound" FontSize="13"/>
                        <CheckBox x:Name="ReceiptPrintCheck" Content="Receipt Print Sound" FontSize="13"/>
                        <CheckBox x:Name="BackupCompleteCheck" Content="Backup Complete Sound" FontSize="13"/>
                        <Separator Margin="0,4"/>
                        <Button x:Name="SelectAllSoundsButton" Content="Select All" FontSize="12"
                                Background="Transparent" Foreground="#3B82F6" HorizontalAlignment="Left" Padding="0"/>
                      </StackPanel>
                    </Border>
                  </Popup>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="Volume" FontSize="12" Foreground="#64748B"/>
                  <Grid ColumnDefinitions="*,50">
                    <Slider x:Name="VolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5"/>
                    <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="80%" FontSize="12"
                               Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="TestSoundCombo" Width="220" Height="36"/>
                <Button x:Name="TestSoundButton" Content="Test Sound" Height="36"
                        Background="#0F2A43" Foreground="White" CornerRadius="6" Padding="14,4"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- About -->
          <Border x:Name="PanelAbout" Background="White" CornerRadius="10" Padding="24" BoxShadow="0 1 4 0 #22000000" IsVisible="False">
            <StackPanel Spacing="18">

              <StackPanel Spacing="10">
                <TextBlock Text="📱 Application Information" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <Border Background="#F8FAFC" CornerRadius="8" Padding="16">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Application Name" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="PharmaPro" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Version" FontSize="12" Foreground="#64748B"/><TextBlock Name="SettingsVersionText" Grid.Column="1" Text="2.0.0" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Edition" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="Desktop" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Platform" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="Windows &amp; macOS" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="License" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="Proprietary" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Database" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="Local Pharmacy Database" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Language" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" x:Name="AboutLanguageText" Text="English/Somali" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Currency" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" x:Name="AboutCurrencyText" Text="$" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Release Year" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="2026" FontSize="12" Foreground="#334155"/></Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock Text="System Information" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <Border Background="#F8FAFC" CornerRadius="8" Padding="16">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Application Version" FontSize="12" Foreground="#64748B"/><TextBlock Name="SettingsAppVersionText" Grid.Column="1" Text="2.0.0" FontSize="12" Foreground="#334155"/></Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                      <Button x:Name="CheckUpdateButton" Content="Check for Updates" Height="32"
                              Background="#3B82F6" Foreground="White" CornerRadius="6" Padding="14,4" FontSize="12"/>
                      <TextBlock x:Name="UpdateStatusText" FontSize="12" VerticalAlignment="Center" Foreground="#64748B" IsVisible="False"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Database Version" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="1.0" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Last Backup" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="Available in Backup &amp; Restore" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Database Size" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" x:Name="AboutDbSizeText" Text="—" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Installation Date" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" x:Name="AboutInstallDateText" Text="—" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="Current User" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" x:Name="AboutCurrentUserText" Text="—" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="License Expires" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" x:Name="AboutLicenseExpiryText" Text="—" FontSize="12" Foreground="#334155"/></Grid>
                    <Grid ColumnDefinitions="170,*"><TextBlock Grid.Column="0" Text="System Status" FontSize="12" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="🟢 Healthy" FontSize="12" Foreground="#334155"/></Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock Text="👨‍💻 Developed By" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <Border Background="#F8FAFC" CornerRadius="8" Padding="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Ahmed Osman" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="PharmaPro" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="📧 pharmaprofficial@gmail.com" FontSize="12" Foreground="#334155" Margin="0,6,0,0"/>
                    <TextBlock Text="📞 +252 47 34969" FontSize="12" Foreground="#334155"/>
                    <TextBlock Text="PharmaPro is independently developed by Ahmed Osman as a desktop pharmacy management solution."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14">
                <TextBlock Text="PharmaPro is designed to keep pharmacy operational data within the local application database. Users are responsible for maintaining regular backups and protecting access to their pharmacy system."
                           FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap"/>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Text="📄 Copyright" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="© 2026 Ahmed Osman. All rights reserved." FontSize="12" Foreground="#64748B"/>
              </StackPanel>

              <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Border Width="36" Height="36" CornerRadius="8" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="4" HorizontalAlignment="Center">
                  <Image Source="avares://PharmacyMS.Desktop/Assets/pharmapro-icon.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Name="SettingsFooterVersionText" Text="PharmaPro v2.0.0" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                <TextBlock Text="Reliable • Secure • Simple" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
              </StackPanel>

            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.navitem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Button.navitem:pointerover">
      <Setter Property="Background" Value="#F8FAFC"/>
    </Style>
    <Style Selector="Button.navitem.active">
      <Setter Property="Background" Value="#FEF2F2"/>
      <Setter Property="Foreground" Value="#DC2626"/>
    </Style>
  </UserControl.Styles>

</UserControl>
