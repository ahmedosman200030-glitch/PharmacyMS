using Avalonia.Controls;
using PharmacyMS.Desktop.ViewModels;
using QuestPDF.Fluent;
using QuestPDF.Helpers;
using QuestPDF.Infrastructure;

namespace PharmacyMS.Desktop.Views.Sales;

public partial class CreditSalesView : UserControl
{
    private readonly CreditSalesViewModel _vm;
    private readonly PharmacyMS.Application.Interfaces.Services.IBrandingService? _brandingService;

    public CreditSalesView() { InitializeComponent(); }
    public CreditSalesView(CreditSalesViewModel vm, PharmacyMS.Application.Interfaces.Services.IBrandingService? brandingService = null)
    {
        InitializeComponent();
        _vm = vm;
        _brandingService = brandingService;

        CreditSalesGrid.LoadingRow += (_, e) => e.Row.Header = (e.Row.GetIndex() + 1).ToString();
        CustomerSummaryGrid.LoadingRow += (_, e) => e.Row.Header = (e.Row.GetIndex() + 1).ToString();

        AttachedToVisualTree += async (_, _) => await RefreshAsync();

        SearchBox.TextChanged += (_, _) =>
        {
            _vm.ApplyFilter(SearchBox.Text ?? "");
            CreditSalesGrid.ItemsSource = null;
            CreditSalesGrid.ItemsSource = _vm.FilteredSales;
        };

        // Record payment on invoice grid
        CreditSalesGrid.AddHandler(Button.ClickEvent, async (object? sender, Avalonia.Interactivity.RoutedEventArgs e) =>
        {
            if (e.Source is not Button btn || btn.Name != "RecordPaymentBtn") return;
            if (btn.DataContext is not CreditSaleRow row) return;
            var owner = TopLevel.GetTopLevel(this) as Window;
            if (owner == null) return;
            var amount = await PharmacyMS.Desktop.Views.Shared.PaymentDialog.ShowAsync(owner, row.CustomerName, row.Balance);
            if (amount == null) return;
            await _vm.RecordPaymentAsync(row, amount.Value);
            await RefreshAsync();
            StatusText.Text = $"✓ Recorded ${amount:F2} from {row.CustomerName} on {DateTime.Now:dd MMM yyyy HH:mm}";
        }, Avalonia.Interactivity.RoutingStrategies.Bubble);

        // Show payment history on row selection
        CreditSalesGrid.SelectionChanged += async (_, _) =>
        {
            if (CreditSalesGrid.SelectedItem is not CreditSaleRow row) return;
            var payments = await _vm.GetPaymentHistoryAsync(row.Sale.Id);
            if (payments.Count == 0)
            {
                StatusText.Text = $"{row.InvoiceNumber}: No payments recorded yet.";
                return;
            }
            var history = string.Join(" | ", payments.Select(p => $"{p.PaidAt:dd MMM yyyy} → ${p.Amount:F2}"));
            StatusText.Text = $"{row.InvoiceNumber} payments: {history}";
        };

        // Send reminder per customer row
        CustomerSummaryGrid.AddHandler(Button.ClickEvent, (object? sender, Avalonia.Interactivity.RoutedEventArgs e) =>
        {
            if (e.Source is not Button btn || btn.Name != "SendReminderRowBtn") return;
            if (btn.DataContext is not CustomerCreditSummary summary) return;
            SendReminder(summary);
        }, Avalonia.Interactivity.RoutingStrategies.Bubble);

        // Send all reminders
        SendReminderBtn.Click += (_, _) =>
        {
            var unpaid = _vm.CustomerSummaries.Where(s => s.Balance > 0).ToList();
            foreach (var s in unpaid) SendReminder(s);
            StatusText.Text = $"✓ Reminders prepared for {unpaid.Count} customer(s)";
        };

        // Summary Report PDF (was Print Statement)
        ExportReportBtn.Click += (_, _) =>
        {
            var selected = CustomerDropdown.SelectedItem as string;
            var filterCustomer = (selected == null || selected == "All Customers") ? null : selected;
            PrintStatement(filterCustomer);
        };

        // Per-customer statement PDF
        PrintStatementBtn.Click += (_, _) =>
        {
            var selected = CustomerDropdown.SelectedItem as string;
            var filterCustomer = (selected == null || selected == "All Customers") ? null : selected;
            PrintPerCustomerStatement(filterCustomer);
        };
    }

    private async Task RefreshAsync()
    {
        await _vm.LoadAsync();
        TotalOutstandingText.Text = $"${_vm.TotalOutstanding:F2}";
        OverdueText.Text = $"${_vm.TotalOverdue:F2}";
        UnpaidCountText.Text = $"{_vm.UnpaidCount} unpaid invoices";
        CustomersCountText.Text = _vm.CustomersCount.ToString();
        CreditSalesGrid.ItemsSource = _vm.FilteredSales;
        CustomerSummaryGrid.ItemsSource = _vm.CustomerSummaries;
        PopulateCustomerDropdown();
    }

    private void PopulateCustomerDropdown()
    {
        var selected = CustomerDropdown.SelectedItem as string;
        CustomerDropdown.Items.Clear();
        CustomerDropdown.Items.Add("All Customers");
        foreach (var s in _vm.CustomerSummaries.Where(s => s.Balance > 0).Select(s => s.CustomerName))
            CustomerDropdown.Items.Add(s);
        CustomerDropdown.SelectedIndex = 0;
        if (selected != null)
        {
            for (int i = 0; i < CustomerDropdown.Items.Count; i++)
                if (CustomerDropdown.Items[i] as string == selected) { CustomerDropdown.SelectedIndex = i; break; }
        }
    }

    private void SendReminder(CustomerCreditSummary summary)
    {
        var message = Uri.EscapeDataString(
            $"Dear {summary.CustomerName}, this is a payment reminder from Pharmacy MS. " +
            $"You have an outstanding balance of ${summary.Balance:F2} on {summary.TotalInvoices} invoice(s). " +
            $"Please settle at your earliest convenience. Thank you.");
        var phone = summary.Phone.Replace(" ", "").Replace("+", "");
        var url = $"https://wa.me/{phone}?text={message}";
        try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url) { UseShellExecute = true }); }
        catch { StatusText.Text = $"Could not open WhatsApp for {summary.CustomerName}"; }
    }

    private async void PrintStatement(string? customerFilter = null)
    {
        QuestPDF.Settings.License = LicenseType.Community;

        // Load branding
        var branding = _brandingService != null
            ? await _brandingService.GetAsync()
            : new PharmacyMS.Application.Interfaces.Services.BrandingSettings();

        var pharmacyName = !string.IsNullOrWhiteSpace(branding.PharmacyName) ? branding.PharmacyName : branding.AppName;
        var address = branding.Address ?? "Hargeisa, Somaliland";
        var phone = branding.PhoneNumber ?? "";
        var mobile = branding.MobileNumber ?? "";
        var email = branding.Email ?? "";
        var contactNumber = branding.ContactNumber ?? "";
        var logoPath = branding.LogoPath ?? "";
        var printedBy = PharmacyMS.Application.Services.SessionManager.CurrentUser?.FullName ?? "Admin";

        var customersToPrint = customerFilter == null
            ? _vm.CustomerSummaries.Where(s => s.Balance > 0).ToList()
            : _vm.CustomerSummaries.Where(s => s.Balance > 0 && s.CustomerName == customerFilter).ToList();

        // Pre-load payment histories
        var allPayments = new Dictionary<int, List<PharmacyMS.Domain.Entities.SalePayment>>();
        foreach (var inv in _vm.FilteredSales)
            allPayments[inv.Sale.Id] = await _vm.GetPaymentHistoryAsync(inv.Sale.Id);

        var reportNo = $"CR-{DateTime.Now:yyyy-MMdd}-{new Random().Next(100, 999)}";
        var reportTitle = customerFilter == null ? "Customer Credit Summary" : $"Credit Statement — {customerFilter}";

        // Ageing buckets
        decimal age0_30 = 0, age31_60 = 0, age61_90 = 0, age90plus = 0;
        foreach (var inv in _vm.FilteredSales.Where(r => r.Balance > 0))
        {
            var days = (DateTime.Today - inv.CreatedAt.Date).Days;
            if (days <= 30) age0_30 += inv.Balance;
            else if (days <= 60) age31_60 += inv.Balance;
            else if (days <= 90) age61_90 += inv.Balance;
            else age90plus += inv.Balance;
        }

        var doc = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.A4.Landscape());
                page.Margin(20);
                page.DefaultTextStyle(x => x.FontSize(9).FontFamily("Arial"));

                page.Header().Column(col =>
                {
                    // Top header
                    col.Item().Row(row =>
                    {
                        // Logo + pharmacy info
                        row.ConstantItem(220).Row(logoRow =>
                        {
                            if (!string.IsNullOrWhiteSpace(logoPath) && File.Exists(logoPath))
                            {
                                logoRow.ConstantItem(60).Image(logoPath).FitArea();
                                logoRow.ConstantItem(8);
                            }
                            logoRow.RelativeItem().Column(c =>
                            {
                                c.Item().Text(pharmacyName).FontSize(16).Bold().FontColor("#DC2626");
                                c.Item().Text("Pharmacy Management System").FontSize(8).FontColor("#64748B");
                                if (!string.IsNullOrWhiteSpace(address))
                                    c.Item().Text($"📍 {address}").FontSize(8).FontColor("#64748B");
                                if (!string.IsNullOrWhiteSpace(phone))
                                    c.Item().Text($"📞 {phone}").FontSize(8).FontColor("#64748B");
                                if (!string.IsNullOrWhiteSpace(email))
                                    c.Item().Text($"✉ {email}").FontSize(8).FontColor("#64748B");
                            });
                        });

                        // Center title
                        row.RelativeItem().AlignCenter().Column(c =>
                        {
                            c.Item().AlignCenter().Text("CREDIT REPORT").FontSize(22).Bold().FontColor("#0F172A");
                            c.Item().AlignCenter().Text(reportTitle).FontSize(11).FontColor("#64748B");
                            c.Item().AlignCenter().PaddingTop(4).Text($"From: {_vm.FilteredSales.Min(s => s.CreatedAt):dd/MM/yyyy}    To: {DateTime.Today:dd/MM/yyyy}").FontSize(10).Bold().FontColor("#DC2626");
                        });

                        // Report info box
                        row.ConstantItem(180).AlignRight().Border(1).BorderColor("#E2E8F0").Padding(8).Column(c =>
                        {
                            c.Item().Row(r => { r.ConstantItem(80).Text("Report No").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {reportNo}").FontSize(8).Bold(); });
                            c.Item().Row(r => { r.ConstantItem(80).Text("Report Date").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {DateTime.Today:dd/MM/yyyy}").FontSize(8); });
                            c.Item().Row(r => { r.ConstantItem(80).Text("Printed By").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {printedBy}").FontSize(8); });
                            c.Item().Row(r => { r.ConstantItem(80).Text("Printed Time").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {DateTime.Now:hh:mm tt}").FontSize(8); });
                        });
                    });

                    // Red divider
                    col.Item().PaddingVertical(6).LineHorizontal(2).LineColor("#DC2626");

                    // Summary cards
                    col.Item().Row(row =>
                    {
                        void Card(string label, string value, string color) =>
                            row.RelativeItem().Border(1).BorderColor("#E2E8F0").Padding(8).Column(c =>
                            {
                                c.Item().Text(label).FontSize(8).Bold().FontColor("#64748B");
                                c.Item().Text(value).FontSize(14).Bold().FontColor(color);
                            });

                        Card("Total Customers on Credit", customersToPrint.Count.ToString(), "#DC2626");
                        Card("Total Credit Sales", $"$ {customersToPrint.Sum(s => s.TotalOwed):N2}", "#0F172A");
                        Card("Total Payments", $"$ {customersToPrint.Sum(s => s.TotalPaid):N2}", "#16A34A");
                        Card("Total Outstanding", $"$ {customersToPrint.Sum(s => s.Balance):N2}", "#DC2626");
                        Card("Overdue Amount", $"$ {_vm.TotalOverdue:N2}", "#DC2626");
                    });

                    col.Item().PaddingTop(6).LineHorizontal(1).LineColor("#E2E8F0");
                });

                page.Content().PaddingTop(8).Column(col =>
                {
                    // Table header
                    col.Item().Background("#DC2626").Padding(6).Row(row =>
                    {
                        row.ConstantItem(25).Text("#").Bold().FontColor(Colors.White).AlignCenter();
                        row.ConstantItem(70).Text("Cust. Code").Bold().FontColor(Colors.White);
                        row.RelativeItem().Text("Customer Name").Bold().FontColor(Colors.White);
                        row.ConstantItem(90).Text("Phone").Bold().FontColor(Colors.White);
                        row.ConstantItem(75).Text("Total Sales").Bold().FontColor(Colors.White).AlignRight();
                        row.ConstantItem(75).Text("Total Paid").Bold().FontColor(Colors.White).AlignRight();
                        row.ConstantItem(80).Text("Outstanding").Bold().FontColor(Colors.White).AlignRight();
                        row.ConstantItem(70).Text("Overdue Amt").Bold().FontColor(Colors.White).AlignRight();
                        row.ConstantItem(80).Text("Last Payment").Bold().FontColor(Colors.White).AlignCenter();
                        row.ConstantItem(50).Text("Days O/D").Bold().FontColor(Colors.White).AlignCenter();
                        row.ConstantItem(50).Text("Status").Bold().FontColor(Colors.White).AlignCenter();
                    });

                    bool alt = false;
                    int num = 0;
                    decimal totalSales = 0, totalPaid = 0, totalBal = 0, totalOverdue = 0;

                    foreach (var s in customersToPrint)
                    {
                        num++;
                        alt = !alt;
                        var bg = alt ? "#F8FAFC" : "#FFFFFF";

                        var custInvoices = _vm.FilteredSales.Where(r => r.CustomerName == s.CustomerName).ToList();
                        var lastPmtDate = "—";
                        DateTime? lastPmt = null;
                        foreach (var inv in custInvoices)
                        {
                            if (allPayments.TryGetValue(inv.Sale.Id, out var pmts) && pmts.Count > 0)
                            {
                                var last = pmts.Max(p => p.PaidAt);
                                if (lastPmt == null || last > lastPmt) { lastPmt = last; lastPmtDate = last.ToString("dd/MM/yyyy"); }
                            }
                        }

                        var daysOverdue = (DateTime.Today - s.LastSaleDate.Date).Days;
                        var custOverdue = custInvoices.Where(r => r.Balance > 0 && (DateTime.Today - r.CreatedAt.Date).Days > 30).Sum(r => r.Balance);
                        var statusText = s.Balance <= 0 ? "Paid" : daysOverdue > 30 ? "Overdue" : "Active";
                        var statusColor = statusText == "Paid" ? "#16A34A" : statusText == "Overdue" ? "#DC2626" : "#16A34A";

                        totalSales += s.TotalOwed; totalPaid += s.TotalPaid; totalBal += s.Balance; totalOverdue += custOverdue;

                        col.Item().Background(bg).BorderBottom(1).BorderColor("#E2E8F0").Padding(5).Row(row =>
                        {
                            row.ConstantItem(25).Text(num.ToString()).AlignCenter().FontColor("#64748B");
                            row.ConstantItem(70).Text($"CUST-{s.CustomerName.GetHashCode() % 9000 + 1000:D4}").FontColor("#64748B");
                            row.RelativeItem().Text(s.CustomerName).Bold();
                            row.ConstantItem(90).Text(s.Phone).FontColor("#64748B");
                            row.ConstantItem(75).Text($"$ {s.TotalOwed:N2}").AlignRight();
                            row.ConstantItem(75).Text($"$ {s.TotalPaid:N2}").AlignRight().FontColor("#16A34A");
                            row.ConstantItem(80).Text($"$ {s.Balance:N2}").AlignRight().Bold().FontColor("#DC2626");
                            row.ConstantItem(70).Text(custOverdue > 0 ? $"$ {custOverdue:N2}" : "$ 0.00").AlignRight().FontColor(custOverdue > 0 ? "#DC2626" : "#16A34A");
                            row.ConstantItem(80).Text(lastPmtDate).AlignCenter().FontColor("#64748B");
                            row.ConstantItem(50).Text(daysOverdue > 0 ? daysOverdue.ToString() : "0").AlignCenter().FontColor(daysOverdue > 30 ? "#DC2626" : "#64748B");
                            row.ConstantItem(50).Text(statusText).AlignCenter().Bold().FontColor(statusColor);
                        });
                    }

                    // Totals row
                    col.Item().Background("#FEE2E2").Padding(5).Row(row =>
                    {
                        row.ConstantItem(25);
                        row.ConstantItem(70);
                        row.RelativeItem().Text("TOTALS").Bold();
                        row.ConstantItem(90);
                        row.ConstantItem(75).Text($"$ {totalSales:N2}").AlignRight().Bold();
                        row.ConstantItem(75).Text($"$ {totalPaid:N2}").AlignRight().Bold().FontColor("#16A34A");
                        row.ConstantItem(80).Text($"$ {totalBal:N2}").AlignRight().Bold().FontColor("#DC2626");
                        row.ConstantItem(70).Text($"$ {totalOverdue:N2}").AlignRight().Bold().FontColor("#DC2626");
                        row.ConstantItem(80);
                        row.ConstantItem(50);
                        row.ConstantItem(50);
                    });

                    // Ageing summary + Notes
                    col.Item().PaddingTop(14).Row(row =>
                    {
                        // Ageing
                        row.RelativeItem().Border(1).BorderColor("#E2E8F0").Padding(10).Column(c =>
                        {
                            c.Item().Text("OUTSTANDING AGEING SUMMARY").Bold().FontSize(10).FontColor("#DC2626");
                            c.Item().PaddingTop(6).Row(r =>
                            {
                                void AgeCol(string label, decimal val, string color) =>
                                    r.RelativeItem().Column(ac =>
                                    {
                                        ac.Item().Text(label).FontSize(8).FontColor("#64748B");
                                        ac.Item().Text($"$ {val:N2}").FontSize(11).Bold().FontColor(color);
                                    });
                                AgeCol("Current (0-30 Days)", age0_30, "#16A34A");
                                AgeCol("31-60 Days", age31_60, "#F59E0B");
                                AgeCol("61-90 Days", age61_90, "#F97316");
                                AgeCol("Over 90 Days", age90plus, "#DC2626");
                                AgeCol("Total", age0_30 + age31_60 + age61_90 + age90plus, "#0F172A");
                            });
                        });

                        row.ConstantItem(10);

                        // Notes
                        row.ConstantItem(280).Border(1).BorderColor("#E2E8F0").Padding(10).Column(c =>
                        {
                            c.Item().Text("NOTES:").Bold().FontSize(10).FontColor("#DC2626");
                            c.Item().PaddingTop(4).Text("• This report shows all customers with outstanding credit balances.").FontSize(8).FontColor("#64748B");
                            c.Item().Text("• Please collect payments on time to avoid overdue.").FontSize(8).FontColor("#64748B");
                            c.Item().Text("• Overdue amounts are balances older than 30 days.").FontSize(8).FontColor("#64748B");
                        });
                    });
                });

                page.Footer().PaddingTop(8).Row(row =>
                {
                    row.RelativeItem().Column(c =>
                    {
                        c.Item().Text("Thank you for your business!").Italic().FontSize(10).FontColor("#DC2626").Bold();
                    });
                    row.ConstantItem(200).AlignRight().Column(c =>
                    {
                        c.Item().PaddingBottom(20).Text("").FontSize(8);
                        c.Item().LineHorizontal(1).LineColor("#0F172A");
                        c.Item().AlignCenter().Text("Authorized Signature").FontSize(8).FontColor("#64748B");
                    });
                    row.ConstantItem(20);
                    row.ConstantItem(60).AlignRight().Column(c =>
                    {
                        c.Item().Text(t =>
                        {
                            t.Span("Page ").FontSize(8).FontColor("#64748B");
                            t.CurrentPageNumber().FontSize(8).FontColor("#64748B");
                            t.Span(" of ").FontSize(8).FontColor("#64748B");
                            t.TotalPages().FontSize(8).FontColor("#64748B");
                        });
                    });
                });
            });
        });

        var path = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
            $"CreditReport_{DateTime.Now:yyyyMMdd_HHmm}.pdf");
        doc.GeneratePdf(path);
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path) { UseShellExecute = true });
        StatusText.Text = $"✓ PDF saved to Desktop";
    }
    private void ShowSummaryReport()
    {
        var lines = new System.Text.StringBuilder();
        lines.AppendLine("CREDIT SUMMARY REPORT — PHARMACY MS");
        lines.AppendLine($"Generated: {DateTime.Now:dd MMM yyyy HH:mm}");
        lines.AppendLine(new string('=', 60));
        lines.AppendLine($"Total Outstanding:  ${_vm.TotalOutstanding:F2}");
        lines.AppendLine($"Overdue (30+ days): ${_vm.TotalOverdue:F2}");
        lines.AppendLine($"Unpaid Invoices:    {_vm.UnpaidCount}");
        lines.AppendLine($"Customers:          {_vm.CustomersCount}");
        lines.AppendLine(new string('=', 60));
        lines.AppendLine("\nTOP OUTSTANDING CUSTOMERS:");
        lines.AppendLine(new string('-', 60));
        foreach (var s in _vm.CustomerSummaries.Where(s => s.Balance > 0).Take(10))
            lines.AppendLine($"{s.CustomerName,-30} Balance: ${s.Balance:F2}  Phone: {s.Phone}");

        var path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), $"CreditReport_{DateTime.Now:yyyyMMdd}.txt");
        File.WriteAllText(path, lines.ToString());
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path) { UseShellExecute = true });
        StatusText.Text = "✓ Report saved to Desktop";
    }

    private async void PrintPerCustomerStatement(string? customerFilter = null)
    {
        QuestPDF.Settings.License = LicenseType.Community;

        var branding = _brandingService != null
            ? await _brandingService.GetAsync()
            : new PharmacyMS.Application.Interfaces.Services.BrandingSettings();

        var pharmacyName = !string.IsNullOrWhiteSpace(branding.PharmacyName) ? branding.PharmacyName : branding.AppName;
        var address = branding.Address ?? "";
        var phone = branding.PhoneNumber ?? "";
        var email = branding.Email ?? "";
        var contactNumber = branding.ContactNumber ?? "";
        var logoPath = branding.LogoPath ?? "";
        var printedBy = PharmacyMS.Application.Services.SessionManager.CurrentUser?.FullName ?? "Admin";

        var customersToPrint = customerFilter == null
            ? _vm.CustomerSummaries.Where(s => s.Balance > 0).ToList()
            : _vm.CustomerSummaries.Where(s => s.Balance > 0 && s.CustomerName == customerFilter).ToList();

        var allPayments = new Dictionary<int, List<PharmacyMS.Domain.Entities.SalePayment>>();
        foreach (var inv in _vm.FilteredSales)
            allPayments[inv.Sale.Id] = await _vm.GetPaymentHistoryAsync(inv.Sale.Id);

        var doc = Document.Create(container =>
        {
            foreach (var s in customersToPrint)
            {
                container.Page(page =>
                {
                    page.Size(PageSizes.A4);
                    page.Margin(30);
                    page.DefaultTextStyle(x => x.FontSize(10));

                    page.Header().Column(col =>
                    {
                        col.Item().Row(row =>
                        {
                            // Logo + pharmacy
                            row.ConstantItem(200).Row(lr =>
                            {
                                if (!string.IsNullOrWhiteSpace(logoPath) && File.Exists(logoPath))
                                { lr.ConstantItem(50).Image(logoPath).FitArea(); lr.ConstantItem(6); }
                                lr.RelativeItem().Column(c =>
                                {
                                    c.Item().Text(pharmacyName).FontSize(14).Bold().FontColor("#DC2626");
                                    c.Item().Text("Pharmacy Management System").FontSize(8).FontColor("#64748B");
                                    if (!string.IsNullOrWhiteSpace(address)) c.Item().Text($"📍 {address}").FontSize(8).FontColor("#64748B");
                                    if (!string.IsNullOrWhiteSpace(phone)) c.Item().Text($"📞 {phone}").FontSize(8).FontColor("#64748B");
                                    if (!string.IsNullOrWhiteSpace(email)) c.Item().Text($"✉ {email}").FontSize(8).FontColor("#64748B");
                                    if (!string.IsNullOrWhiteSpace(contactNumber)) c.Item().Text($"☎ Contact: {contactNumber}").FontSize(8).Bold().FontColor("#0F172A");
                                });
                            });

                            // Title
                            row.RelativeItem().AlignCenter().Column(c =>
                            {
                                c.Item().AlignCenter().Text("CREDIT STATEMENT").FontSize(20).Bold().FontColor("#0F172A");
                                c.Item().AlignCenter().Text($"Statement for: {s.CustomerName}").FontSize(11).FontColor("#64748B");
                                c.Item().AlignCenter().PaddingTop(4).Text($"Date: {DateTime.Today:dd MMM yyyy}").FontSize(10).FontColor("#DC2626").Bold();
                            });

                            // Info box
                            row.ConstantItem(160).Border(1).BorderColor("#E2E8F0").Padding(8).Column(c =>
                            {
                                c.Item().Row(r => { r.ConstantItem(60).Text("Printed By").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {printedBy}").FontSize(8); });
                                c.Item().Row(r => { r.ConstantItem(60).Text("Date").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {DateTime.Today:dd/MM/yyyy}").FontSize(8); });
                                c.Item().Row(r => { r.ConstantItem(60).Text("Time").FontSize(8).FontColor("#64748B"); r.RelativeItem().Text($": {DateTime.Now:hh:mm tt}").FontSize(8); });
                            });
                        });

                        col.Item().PaddingVertical(6).LineHorizontal(2).LineColor("#DC2626");

                        // Customer info box
                        col.Item().Background("#F8FAFC").Border(1).BorderColor("#E2E8F0").Padding(10).Row(row =>
                        {
                            row.RelativeItem().Column(c =>
                            {
                                c.Item().Text("CUSTOMER DETAILS").FontSize(9).Bold().FontColor("#64748B");
                                c.Item().PaddingTop(4).Text(s.CustomerName).FontSize(13).Bold();
                                if (s.Phone != "—") c.Item().Text($"📞 {s.Phone}").FontSize(9).FontColor("#64748B");
                                if (s.Email != "—") c.Item().Text($"✉ {s.Email}").FontSize(9).FontColor("#64748B");
                                if (s.Address != "—") c.Item().Text($"📍 {s.Address}").FontSize(9).FontColor("#64748B");
                            });
                            row.ConstantItem(200).Column(c =>
                            {
                                c.Item().Text("ACCOUNT SUMMARY").FontSize(9).Bold().FontColor("#64748B");
                                c.Item().PaddingTop(4).Row(r => { r.RelativeItem().Text("Total Invoices:").FontSize(9); r.ConstantItem(80).Text(s.TotalInvoices.ToString()).FontSize(9).Bold(); });
                                c.Item().Row(r => { r.RelativeItem().Text("Total Owed:").FontSize(9); r.ConstantItem(80).Text($"${s.TotalOwed:F2}").FontSize(9).Bold(); });
                                c.Item().Row(r => { r.RelativeItem().Text("Total Paid:").FontSize(9); r.ConstantItem(80).Text($"${s.TotalPaid:F2}").FontSize(9).Bold().FontColor("#16A34A"); });
                                c.Item().Row(r => { r.RelativeItem().Text("Balance Due:").FontSize(9).Bold(); r.ConstantItem(80).Text($"${s.Balance:F2}").FontSize(11).Bold().FontColor("#DC2626"); });
                                c.Item().Row(r => { r.RelativeItem().Text("Last Sale:").FontSize(9); r.ConstantItem(80).Text(s.LastSaleDate.ToString("dd MMM yyyy")).FontSize(9).FontColor("#64748B"); });
                            });
                        });

                        col.Item().PaddingTop(8).LineHorizontal(1).LineColor("#E2E8F0");
                    });

                    page.Content().PaddingTop(8).Column(col =>
                    {
                        // Invoice table header
                        col.Item().Background("#DC2626").Padding(6).Row(row =>
                        {
                            row.ConstantItem(140).Text("Invoice #").Bold().FontColor(Colors.White).FontSize(9);
                            row.ConstantItem(80).Text("Date").Bold().FontColor(Colors.White).FontSize(9);
                            row.ConstantItem(70).Text("Total").Bold().FontColor(Colors.White).FontSize(9).AlignRight();
                            row.ConstantItem(70).Text("Paid").Bold().FontColor(Colors.White).FontSize(9).AlignRight();
                            row.ConstantItem(70).Text("Balance").Bold().FontColor(Colors.White).FontSize(9).AlignRight();
                            row.RelativeItem().Text("Status").Bold().FontColor(Colors.White).FontSize(9).AlignCenter();
                        });

                        var invoices = _vm.FilteredSales
                            .Where(r => r.CustomerName == s.CustomerName)
                            .OrderBy(r => r.CreatedAt)
                            .ToList();

                        bool alt = false;
                        foreach (var inv in invoices)
                        {
                            alt = !alt;
                            var bg = alt ? "#F8FAFC" : "#FFFFFF";
                            var statusColor = inv.Status == "Paid" ? "#16A34A" : inv.Status == "Partial" ? "#F59E0B" : "#DC2626";

                            col.Item().Background(bg).BorderBottom(1).BorderColor("#E2E8F0").Padding(6).Column(invCol =>
                            {
                                invCol.Item().Row(row =>
                                {
                                    row.ConstantItem(140).Text(inv.InvoiceNumber).FontSize(9);
                                    row.ConstantItem(80).Text(inv.CreatedAt.ToString("dd MMM yyyy")).FontSize(9).FontColor("#64748B");
                                    row.ConstantItem(70).Text($"${inv.TotalAmount:F2}").FontSize(9).AlignRight();
                                    row.ConstantItem(70).Text($"${inv.AmountPaid:F2}").FontSize(9).AlignRight().FontColor("#16A34A");
                                    row.ConstantItem(70).Text($"${inv.Balance:F2}").FontSize(9).AlignRight().Bold().FontColor(statusColor);
                                    row.RelativeItem().Text(inv.Status).FontSize(9).AlignCenter().Bold().FontColor(statusColor);
                                });

                                // Items purchased
                                if (inv.Sale.Items.Count > 0)
                                {
                                    invCol.Item().PaddingLeft(16).PaddingTop(4).Background("#F8FAFC").Padding(6).Column(itemsCol =>
                                    {
                                        itemsCol.Item().Text("Items Purchased:").FontSize(8).Bold().FontColor("#0F172A");
                                        itemsCol.Item().PaddingTop(2).Row(hrow =>
                                        {
                                            hrow.RelativeItem().Text("Medicine").FontSize(7.5f).Bold().FontColor("#94A3B8");
                                            hrow.ConstantItem(40).Text("Qty").FontSize(7.5f).Bold().FontColor("#94A3B8").AlignCenter();
                                            hrow.ConstantItem(55).Text("Unit Price").FontSize(7.5f).Bold().FontColor("#94A3B8").AlignRight();
                                            hrow.ConstantItem(55).Text("Total").FontSize(7.5f).Bold().FontColor("#94A3B8").AlignRight();
                                        });
                                        itemsCol.Item().LineHorizontal(0.5f).LineColor("#E2E8F0");
                                        foreach (var item in inv.Sale.Items)
                                        {
                                            itemsCol.Item().PaddingTop(2).Row(irow =>
                                            {
                                                irow.RelativeItem().Text($"• {item.MedicineName}").FontSize(8).FontColor("#334155");
                                                irow.ConstantItem(40).Text(item.Quantity.ToString()).FontSize(8).FontColor("#64748B").AlignCenter();
                                                irow.ConstantItem(55).Text($"${item.UnitPrice:F2}").FontSize(8).FontColor("#64748B").AlignRight();
                                                irow.ConstantItem(55).Text($"${item.UnitPrice * item.Quantity:F2}").FontSize(8).Bold().FontColor("#334155").AlignRight();
                                            });
                                        }
                                    });
                                }

                                // Payment history
                                if (allPayments.TryGetValue(inv.Sale.Id, out var pmts) && pmts.Count > 0)
                                {
                                    invCol.Item().PaddingLeft(16).PaddingTop(3).Text("Payment History:").FontSize(8).Bold().FontColor("#0F172A");
                                    foreach (var p in pmts)
                                    {
                                        invCol.Item().PaddingLeft(16).Row(row =>
                                        {
                                            row.ConstantItem(12).Text("↳").FontSize(8).FontColor("#16A34A");
                                            row.RelativeItem().Text($"Paid ${p.Amount:F2}  on  {p.PaidAt:dd MMM yyyy  HH:mm}").FontSize(8).FontColor("#16A34A");
                                        });
                                    }
                                }
                                else
                                {
                                    invCol.Item().PaddingLeft(16).PaddingTop(2).Text("↳ No payments recorded yet").FontSize(8).FontColor("#DC2626").Italic();
                                }
                            });
                        }

                        // Totals
                        col.Item().Background("#FEE2E2").Padding(6).Row(row =>
                        {
                            row.ConstantItem(140).Text("TOTAL").Bold().FontSize(10);
                            row.ConstantItem(80);
                            row.ConstantItem(70).Text($"${s.TotalOwed:F2}").Bold().FontSize(10).AlignRight();
                            row.ConstantItem(70).Text($"${s.TotalPaid:F2}").Bold().FontSize(10).AlignRight().FontColor("#16A34A");
                            row.ConstantItem(70).Text($"${s.Balance:F2}").Bold().FontSize(11).AlignRight().FontColor("#DC2626");
                            row.RelativeItem();
                        });
                    });

                    page.Footer().PaddingTop(10).Row(row =>
                    {
                        row.RelativeItem().Column(c =>
                        {
                            c.Item().Text("Thank you for your business!").Italic().FontSize(10).FontColor("#DC2626").Bold();
                            c.Item().Text("Please settle your balance at your earliest convenience.").FontSize(8).FontColor("#64748B");
                        });
                        row.ConstantItem(180).AlignRight().Column(c =>
                        {
                            c.Item().PaddingBottom(20).Text("");
                            c.Item().LineHorizontal(1).LineColor("#0F172A");
                            c.Item().AlignCenter().Text("Authorized Signature").FontSize(8).FontColor("#64748B");
                        });
                    });
                });
            }
        });

        var path = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
            $"CreditStatement_{DateTime.Now:yyyyMMdd_HHmm}.pdf");
        doc.GeneratePdf(path);
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path) { UseShellExecute = true });
        StatusText.Text = $"✓ Statement PDF saved to Desktop";
    }

}
