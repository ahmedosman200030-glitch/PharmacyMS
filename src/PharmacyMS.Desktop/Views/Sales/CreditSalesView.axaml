<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
        x:Class="PharmacyMS.Desktop.Views.Sales.CreditSalesView"
        x:DataType="vm:CreditSalesViewModel"
        Background="#F1F5F9">
  <DockPanel Margin="14">

    <Border DockPanel.Dock="Top" Background="#0F2A43" CornerRadius="10" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="TOTAL OUTSTANDING" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
        <TextBlock x:Name="TotalOutstandingText" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="White"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontSize="12" Foreground="#22C55E" Margin="0,0,0,8"/>

    <Border Background="White" CornerRadius="10" Padding="10" BoxShadow="0 1 4 0 #22000000">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Credit Sales" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="4,0,0,10"/>
        <DataGrid x:Name="CreditSalesGrid" x:DataType="vm:CreditSaleRow" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" Background="White" Foreground="#334155"
                  RowBackground="White" HorizontalGridLinesBrush="#E2E8F0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="160"/>
            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt}" Width="150"/>
            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="180"/>
            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount}" Width="100"/>
            <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid}" Width="100"/>
            <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="100"/>
            <DataGridTemplateColumn Header="" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:CreditSaleRow">
                  <Button x:Name="RecordPaymentBtn" Content="Record Payment" Height="28" Padding="10,0" Background="#0F2A43" Foreground="White" CornerRadius="6"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
