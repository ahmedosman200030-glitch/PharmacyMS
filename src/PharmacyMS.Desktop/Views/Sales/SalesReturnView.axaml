<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyMS.Desktop.ViewModels"
             xmlns:ent="clr-namespace:PharmacyMS.Domain.Entities;assembly=PharmacyMS.Domain"
             x:Class="PharmacyMS.Desktop.Views.Sales.SalesReturnView"
             x:DataType="vm:SalesReturnViewModel"
             Background="#F1F5F9">

  <UserControl.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#6B7688"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="#1E2532"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="TextBox:focus, ComboBox:focus">
      <Setter Property="BorderBrush" Value="#0D9488"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0D9488"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F766E"/>
    </Style>
    <Style Selector="Button.linkBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#0D9488"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#CCFBF1"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="440,*" Margin="24">

    <Border Grid.Column="0" Background="White" BorderBrush="#E4E8F0" BorderThickness="1"
            CornerRadius="14" Padding="20" Margin="0,0,16,0"
            BoxShadow="0 1 3 0 #14000000">
      <Grid RowDefinitions="*">

        <!-- STEP 1: Sale picker -->
        <StackPanel x:Name="SalePickerPanel" Grid.Row="0" Spacing="10">
          <TextBlock Text="Find the Sale" FontSize="18" FontWeight="Bold" Foreground="#1E2532"/>
          <TextBlock Text="Pick the original invoice to return an item from" Foreground="#6B7688" FontSize="12"/>
          <TextBox x:Name="SearchBox" Height="38" Watermark="Search invoice # or customer…"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
            <ListBox x:Name="SalesList" ItemsSource="{Binding RecentSales}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ent:Sale">
                  <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" FontSize="13" Foreground="#1E2532"/>
                      <TextBlock Text="{Binding CustomerName}" FontSize="12" Foreground="#6B7688"/>
                      <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </StackPanel>

        <!-- STEP 2: Item + return details -->
        <ScrollViewer Grid.Row="0" x:Name="ReturnFormScroll" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ReturnFormPanel" Spacing="14">

            <Button x:Name="BackButton" Content="← Back to sales" Classes="linkBtn" HorizontalAlignment="Left"/>

            <StackPanel>
              <TextBlock x:Name="SelectedInvoiceText" Text="Invoice #" FontSize="18" FontWeight="Bold" Foreground="#1E2532"/>
              <TextBlock x:Name="SelectedCustomerText" Text="Customer" Foreground="#6B7688" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#E4E8F0"/>

            <StackPanel Spacing="6">
              <TextBlock Text="ITEM" Classes="eyebrow"/>
              <ComboBox x:Name="ItemBox" Height="38" HorizontalAlignment="Stretch"
                        PlaceholderText="Select item from this invoice…"/>
              <TextBlock x:Name="SoldQtyText" Text="" Foreground="#6B7688" FontSize="12"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="QUANTITY TO RETURN" Classes="eyebrow"/>
              <TextBox x:Name="QtyBox" Height="38" Watermark="0"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="UNIT PRICE (REFUND PER ITEM)" Classes="eyebrow"/>
              <TextBox x:Name="PriceBox" Height="38" Watermark="0.00"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="REFUND METHOD" Classes="eyebrow"/>
              <ComboBox x:Name="PaymentMethodBox" Height="38" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Card"/>
                <ComboBoxItem Content="Mobile"/>
                <ComboBoxItem Content="Store Credit"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="REASON" Classes="eyebrow"/>
              <ComboBox x:Name="ReasonBox" Height="38" HorizontalAlignment="Stretch" PlaceholderText="Select a reason…">
                <ComboBoxItem Content="Customer changed mind"/>
                <ComboBoxItem Content="Wrong item sold"/>
                <ComboBoxItem Content="Defective / damaged"/>
                <ComboBoxItem Content="Doctor changed prescription"/>
                <ComboBoxItem Content="Other"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="NOTES (OPTIONAL)" Classes="eyebrow"/>
              <TextBox x:Name="NotesBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                        Watermark="Appended to the reason…"/>
            </StackPanel>

            <Border Background="#F1F5F9" CornerRadius="7" Padding="10,8">
              <TextBlock x:Name="RefundPreviewText" Text="Refund total: $0.00" Foreground="#1E2532" FontSize="14" FontWeight="Bold"/>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>

            <Button x:Name="SubmitButton" Content="Process Return" Classes="primary" Height="44"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Border>

    <Border Grid.Column="1" Background="White" BorderBrush="#E4E8F0" BorderThickness="1"
            CornerRadius="14" Padding="18" BoxShadow="0 1 3 0 #14000000">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBlock Text="Recent Returns" FontSize="18" FontWeight="Bold" Foreground="#1E2532"/>
          <TextBlock Text="Last 50 returns processed" Foreground="#6B7688" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <DataGrid x:Name="HistoryGrid" HeadersVisibility="All" RowHeaderWidth="40"
                  x:DataType="ent:SaleReturn"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E4E8F0"
                  Background="Transparent"
                  Foreground="#1E2532"
                  RowBackground="Transparent"
                  ColumnWidth="*">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt}" Width="1.4*"/>
            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="1.6*"/>
            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="0.6*"/>
            <DataGridTextColumn Header="Refund" Binding="{Binding RefundAmount}" Width="0.8*"/>
            <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="0.9*"/>
            <DataGridTextColumn Header="Invoice" Binding="{Binding OriginalSaleId}" Width="0.7*"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.8*"/>
            <DataGridTextColumn Header="By" Binding="{Binding ProcessedByName}" Width="1.1*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
